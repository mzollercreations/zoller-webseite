     {
      "type": "textmedia",
      "header": "<h1> La calidad tiene su valor, sobre todo para nuestros clientes. </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3274",
