   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> FAQ </h1>",
      "body": "<p>Preguntas frecuentes</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1581",
