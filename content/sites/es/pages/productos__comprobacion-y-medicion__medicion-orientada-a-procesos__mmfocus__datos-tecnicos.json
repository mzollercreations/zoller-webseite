  {
   "type": "table",
   "header": "<h2> Pesos de instalación </h2>",
   "table": "<table> <tbody> <tr> <td> »mμFocus« con sensor »zep« y sistema bajo mesa </td> <td> 250 »kg </td> </tr> <tr> <td> mμFocus« con sensor »zep-R« y sistema bajo mesa </td> <td> 270 »kg </td> </tr> <tr> <td> mμFocus« con sensor »zep« sin sistema bajo mesa </td> <td> 75 kg </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c4147",
   "bg": "lightgray",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Sensor »zep« para la medición de la geometría del filo </h2>",
      "table": "<table> <tbody> <tr> <td> Eje Z </td> <td> 300 mm </td> </tr> <tr> <td> AA (describe la distancia mínima entre el lente y el objeto de medición) </td> <td> Proyección de rayas 3 </td> </tr> <tr> <td> Principio de medición </td> <td> 0 mm </td> </tr> <tr> <td> Radio mínimo medible </td> <td> 3 μm </td> </tr> <tr> <td> Apertura numérica </td> <td> – </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4149",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Sensor »zep-R« para la medición de la geometría de corte 3D y la rugosidad de la superficie. </h2>",
      "table": "<table> <tbody> <tr> <td> Eje Z </td> <td> 300 mm </td> </tr> <tr> <td> AA </td> <td> 20 mm </td> </tr> <tr> <td> Principio de medición </td> <td> Microscopio confocal </td> </tr> <tr> <td> Radio mínimo medible </td> <td> 3 μm (valores para objetivo de 20 aumentos; valores para objetivo de 50 aumentos: 1,4 μm) </td> </tr> <tr> <td> Apertura numérica </td> <td> 0,42 mm </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4151",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c4148",
   "bg": "",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Rugosidad del perfil: selección de parámetros medibles según las normas ISO 4287 e ISO 13565. </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> valor medio aritmético a lo largo de toda la longitud de medición </td> </tr> <tr> <td> Rq </td> <td> valor medio cuadrático </td> </tr> <tr> <td> Rt </td> <td> altura total del perfil de rugosidad </td> </tr> <tr> <td> Rmax </td> <td> altura máxima del perfil de rugosidad dentro de un tramo de medición individual </td> </tr> <tr> <td> Rz </td> <td> altura media del perfil de rugosidad </td> </tr> <tr> <td> Rp </td> <td> altura del pico más alto del perfil de rugosidad </td> </tr> <tr> <td> Rv </td> <td> fondo del valle más grande del perfil de rugosidad </td> </tr> <tr> <td> Rk </td> <td> fondo del núcleo, altura de la zona central </td> </tr> <tr> <td> Rpk </td> <td> altura de punta reducida </td> </tr> <tr> <td> Rvk </td> <td> fondo de estriado reducido </td> </tr> <tr> <td> Mr1 </td> <td> porcentaje de material por encima de la zona central (curva de Abbott) </td> </tr> <tr> <td> Mr2 </td> <td> porcentaje de material que soporta la carga (curva de Abbott) </td> </tr> <tr> <td> Rsm </td> <td> Ancho medio de las estrías </td> </tr> <tr> <td> RPc </td> <td> Valor de recuento de picos </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Rugosidad de la superficie: selección de parámetros medibles según las normas ISO 25178-2 e ISO 16610. </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> altura aritmética media de la superficie limitada por la escala </td> </tr> <tr> <td> Sq </td> <td> altura cuadrática media de la superficie limitada por la escala </td> </tr> <tr> <td> Sp </td> <td> altura máxima de punta de la superficie limitada por la escala </td> </tr> <tr> <td> Sv </td> <td> altura máxima de los valles de la superficie limitada por la escala </td> </tr> <tr> <td> Sz </td> <td> altura máxima de la superficie limitada por la escala </td> </tr> <tr> <td> S10z </td> <td> Altura de diez puntos de la superficie </td> </tr> <tr> <td> Ssk </td> <td> Asimetría de la superficie limitada por escala </td> </tr> <tr> <td> Sku </td> <td> Kurtosis de la superficie limitada por escala </td> </tr> <tr> <td> Sdq </td> <td> Gradiente cuadrático medio de la superficie limitada por escala </td> </tr> <tr> <td> Sdr </td> <td> Relación de superficie de transición desarrollada de una superficie limitada por escala </td> </tr> <tr> <td> FLT </td> <td> planitud </td> </tr> <tr> <td> Sk </td> <td> altura del núcleo </td> </tr> <tr> <td> Spk </td> <td> altura reducida de las puntas </td> </tr> <tr> <td> Svk </td> <td> altura reducida de los valles </td> </tr> <tr> <td> Smr1 </td> <td> proporción de material de las puntas </td> </tr> <tr> <td> Smr2 </td> <td> proporción de material de los valles </td> </tr> <tr> <td> Vmc </td> <td> Volumen del material del núcleo de una superficie limitada por escala </td> </tr> <tr> <td> Vmp </td> <td> Volumen del material de los picos de una superficie limitada por escala </td> </tr> <tr> <td> Vvc </td> <td> Volumen vacío del núcleo de una superficie limitada por escala </td> </tr> <tr> <td> Vvv </td> <td> Volumen vacío de los valles de una superficie limitada por escala </td> </tr> <tr> <td> Sxp </td> <td> Valor extremo de la altura de punta </td> </tr> <tr> <td> Str </td> <td> Relación de aspecto de la textura de la superficie </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4141",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
