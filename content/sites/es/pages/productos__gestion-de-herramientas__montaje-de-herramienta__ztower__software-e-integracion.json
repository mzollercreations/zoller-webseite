     {
      "type": "textmedia",
      "header": "<h1> Software </h1>",
      "body": "<p class=\"large-text\">Gabinetes inteligentes</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3721",
