      "before": "default",
      "after": "default"
     }
    },
    {
     "type": "textmedia",
     "header": "",
     "body": "",
     "images": [
      {
       "src": "/fileadmin/_processed_/9/5/csm_genius_drabkansai_contentimg_01_9902deb6ec.webp",
