    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Dos modelos, muchas prestaciones incluidas y opciones prácticas: elija entre dos longitudes de la herramienta diferentes y accesorios para un uso diario de forma óptima. Para procesos de trabajo y condiciones totalmente individuales en su producción.<br/><br/>Elija de forma sencilla y con vista general o póngase en contacto con nosotros: estaremos encantados de asesorarle en la selección de su modelo y la innovadora variedad de opciones.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
