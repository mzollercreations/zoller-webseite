    "before": "extra-small",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/8/5/csm_toolBalancer_Alexander_Zoller2_7bc76f629f.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Es hora de modernizar la puesta a disposición de herramientas en los procesos de fabricación. El concepto de automatización modular de ZOLLER abre el camino hacia la fábrica inteligente para cualquier proceso de fabricación. </p> <p><strong>Alexander Zoller, director general</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/2/7/csm_toolBalancer_Christoph_Zoller2_490ea1f2a5.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Las soluciones de automatización de ZOLLER son el siguiente paso lógico. Aumente la eficiencia de su producción con tecnologías innovadoras.</p> <p><strong>Christoph Zoller, director general</strong></p>",
     "right": false,
     "quote": true,
     "dark": true
    }
   ],
   "ftype": "zoller_slider-full-width",
   "id": "c2269",
