        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Indicación gráfica de la posición angular del husillo en el monitor.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/1/2/csm_Optische_Eindrehhilfe_DE_74944f939a.webp",
