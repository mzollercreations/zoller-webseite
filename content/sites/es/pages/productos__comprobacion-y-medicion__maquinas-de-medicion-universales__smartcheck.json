  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Técnica de medición universal para la inspección de la herramienta orientada al proceso</p> <p><a class=\"btn\" href=\"/es/empresa/contacto\">Solicitar ahora</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
