    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2 class=\"headline-decor\"> Mayor productividad </h2>",
   "body": "<p class=\"large-text\">Los tiempos de inactividad de las máquinas son costosos e innecesarios. Si las herramientas preajustadas llegan a la máquina, podrá iniciar antes el siguiente pedido. Maximice ahora su productividad con un aparato de ajuste y medición de ZOLLER.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/e/5/csm_presetting_02_f4a2e05503.webp",
     "alt": "",
     "w": 1220,
     "h": 1250
    }
   ],
   "videos": [],
