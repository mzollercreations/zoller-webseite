  {
   "type": "product_header",
   "title": "Solutions d'outillage",
   "text": "<p>Les porte-outils : l'interface idéale<br/>pour votre fabrication numérique</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Acheter maintenant</a></p>",
   "img": {
