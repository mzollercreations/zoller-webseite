      "items": [
       {
        "title": "Ručné jemné nastavenie",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Ručné kolesá na dodatočné ručné jemné nastavenie osí Z a X, určené špeciálne pre modul kontroly nástrojov.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/8/9/csm_option_feinverstellung_69e5b6735b.webp",
