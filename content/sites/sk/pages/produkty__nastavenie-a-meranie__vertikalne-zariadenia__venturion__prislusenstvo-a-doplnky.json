          }
         }
        ]
       },
       {
        "title": "merací snímač",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Na hmatové meranie rezných hrán nástrojov.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/5/4/csm_option_messtaster_5313cb85ba.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
