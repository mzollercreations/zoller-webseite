  {
   "type": "product_header",
   "title": "»conDiaZ«",
   "text": "<p>Zaznamenávanie obrysov nástrojov na spracovanie kameňa v priebehu niekoľkých sekúnd.</p> <p><a class=\"btn\" href=\"/sk/spolocnost/kontakt\">Požiadajte o informácie</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/3/csm_conDiaz_header_e97f793397.webp",
