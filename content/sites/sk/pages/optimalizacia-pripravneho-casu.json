    [
     {
      "type": "textmedia",
      "header": "<h2> Aké sú výhody optimalizácie prípravného času? </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c8064",
