    [
     {
      "type": "textmedia",
      "header": "<h1> Príslušenstvo<br/>a doplnky </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3356",
