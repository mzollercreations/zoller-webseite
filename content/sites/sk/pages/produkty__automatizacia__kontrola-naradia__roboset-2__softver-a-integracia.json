    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">V programe» pilot 4.0« môžete nastaviť všetky kroky, ktoré má »roboSet 2« vykonať pri nasledujúcich úlohách. Aj v oblasti automatizácie tento softvér presviedča intuitívnym ovládaním, prehľadnými ponukami, veľkými tlačidlami a prispôsobiteľným rozhraním. Kontroly nástrojov budete môcť rýchlo naplánovať a spustiť a údaje veľmi jednoducho zdokumentovať.</p>",
      "images": [],
      "videos": [],
