  {
   "type": "product_header",
   "title": "»pomBasic«",
   "text": "<p>Procesne orientované kompaktné riešenia<br/>pre kontrolu nástrojov</p> <p><a class=\"btn\" href=\"/sk/spolocnost/kontakt\">Požiadať o informácie</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/9/csm_pomBasic_header_e15bc565eb.webp",
    "alt": "",
