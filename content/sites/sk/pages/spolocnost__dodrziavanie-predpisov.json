     {
      "type": "textmedia",
      "header": "<h2> Nerobíme výnimky z pravidiel </h2>",
      "body": "<p class=\"large-text\">Etické a zákonné konanie je súčasťou našej firemnej kultúry. To platí vo vzťahu k zákazníkom, obchodným partnerom, akcionárom a zamestnancom. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c26285",
