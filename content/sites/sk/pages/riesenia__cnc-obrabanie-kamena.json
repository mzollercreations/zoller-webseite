   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Ten, kto dokáže vyrobiť dokonalý obrys za kratší čas, určuje smer súťaže. Tak poďme na to! </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
