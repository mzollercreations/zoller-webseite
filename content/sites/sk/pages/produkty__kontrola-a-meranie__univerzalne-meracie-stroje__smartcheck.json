  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Univerzálna kontrolná a meracie technika<br/>pre procesne orientovanú kontrolu nástrojov</p> <p><a class=\"btn\" href=\"/sk/spolocnost/kontakt\">Požiadať o informácie</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
   "id": "c1606",
   "bg": "",
