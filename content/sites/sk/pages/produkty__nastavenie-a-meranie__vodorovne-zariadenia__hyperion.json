  {
   "type": "highlight",
   "items": [
    "Flexibilné osadenie revolverového stolíka presne podľa potreby",
    "Jeden jediný merací prístroj pre takmer všetky typy upínacích systémov",
    "Špeciálna zliatina a stabilná konštrukcia"
   ],
   "header": "",
   "ftype": "zoller_highlight",
