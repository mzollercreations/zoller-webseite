       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p>Balík STARTER osvedčeného riešenia TMS Tool Management Solutions vám ponúka najdôležitejšie funkcie, vďaka ktorým môžete rýchlo využívať výhody digitálnej správy nástrojov. Vďaka modulárnej štruktúre riešenia TMS Tool Management Solutions môžete svoju správu nástrojov kedykoľvek rozšíriť prostredníctvom balíkov Bronze, Silver a Gold. </p><ul><li>Prístup ku všetkým údajom o nástrojoch</li><li>Získanie informácií o mieste skladovania nástrojov a komponentov</li><li>Správa nastavovacích listov </li></ul><p>Začnite hneď teraz a dosiahnite vyššiu efektivitu vo sklade nástrojov.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c4395",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
