    [
     {
      "type": "textmedia",
      "header": "<h1> STARTER: Vstup do sveta digitálnych nástrojov </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
