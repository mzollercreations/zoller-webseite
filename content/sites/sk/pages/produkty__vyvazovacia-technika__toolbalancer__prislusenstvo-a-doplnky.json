   }
  },
  {
   "type": "textmedia",
   "header": "<h2> Adaptér na vyvažovačku (ďalšie na požiadanie) </h2>",
   "body": "<figure><table><tbody><tr><td>Vyvažovací adaptér SK 30/40/50</td></tr><tr><td>Vyvažovací adaptér HSK 32/40/50/63/80/100 (A/C/E-B/D/F)</td></tr><tr><td>Vyvažovací adaptér PSC C 32/40/50/63/80</td></tr></tbody></table></figure>",
