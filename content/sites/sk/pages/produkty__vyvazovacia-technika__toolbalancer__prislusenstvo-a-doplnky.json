       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Dva modely, bohatá výbava a praktické možnosti: Vyberte si medzi dvoma rôznymi dĺžkami náradia a príslušenstvom pre optimálne každodenné použitie. Pre úplne individuálne pracovné postupy a podmienky vo vašej výrobe.<br/><br/>Vyberte si jednoducho a prehľadne alebo sa na nás obráťte: Radi vám poradíme pri výbere vášho modelu a inovatívnej škály možností.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1109",
      "bg": "",
