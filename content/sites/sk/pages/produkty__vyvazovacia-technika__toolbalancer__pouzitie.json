        "title": "Optická pomôcka na naskrutkovanie",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Grafické zobrazenie uhlovej polohy vretena na monitore.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/1/2/csm_Optische_Eindrehhilfe_DE_74944f939a.webp",
