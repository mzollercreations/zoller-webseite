     "video": "/fileadmin/01_Pages/Startingpage/zollerinfo_header_animation_780.mp4",
     "title": "Systémom k maximu",
     "kicker": "",
     "text": "<p>Zvýšte efektívnosť svojich procesov obrábania<br/>s riešeniami od technologického lídra: ZOLLER. </p>",
     "buttons": [],
     "light": false
    }
