      "type": "textmedia",
      "header": "<h1> 소프트웨어 </h1>",
      "body": "<p class=\"large-text\">자동화</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
