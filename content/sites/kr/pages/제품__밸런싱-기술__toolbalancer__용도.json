          }
         }
        ]
       },
       {
        "title": "두 차원에서의 균형",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>두 평면에서의 불균형 측정 및 보정을 위해 (동적).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/6/1/csm_Wuchten_in_2_Ebenen_DE_b11238d497.webp",
            "alt": "",
            "w": 1000,
            "h": 693
           }
          ],
