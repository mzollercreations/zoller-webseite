          }
         }
        ]
       },
       {
        "title": "한 평면 내의 평형",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>한 평면 내의 불균형을 측정하고 보정하기 위한 것(정적).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/f/6/csm_Wuchten_in_1_Ebene_DE_23e1e800e4.webp",
            "alt": "",
