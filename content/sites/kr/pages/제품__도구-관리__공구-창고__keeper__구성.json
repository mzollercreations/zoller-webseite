    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">스마트 캐비닛은 고객의 요구에 맞춰 직접 구성할 수 있습니다. 원하는 사양을 먼저 선택한 후 ZOLLER 영업팀에 문의해 주세요. 고객의 요구사항에 맞춰 상담을 제공하고, 원하는 모델로 구성해 드립니다.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3068",
      "bg": "",
      "space": {
