       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "accordion",
      "header": "",
      "items": [
       {
        "title": "로봇",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>내장된 충돌 방지 소프트웨어는 설비를 충돌로부터 확실하게 보호합니다. 이중 그리퍼를 통해 신속한 적재 및 하역이 가능하며, 비가동 시간을 줄이고 생산성을 높여줍니다. 모든 그리퍼 상태를 한눈에 파악할 수 있는 디스플레이는 높은 공정 안정성을 보장합니다. 다양한 팔레트 시스템(예: Rollomatic, ZOLLER)을 지원하므로 설비를 유연하게 통합할 수 있습니다. 마킹이 완료되면 공구가 자동으로 팔레트에 직접 적재됩니다.</p>",
          "images": [],
          "videos": [],
          "pos": "text",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c232655",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "팔레트 관리",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>자동화 솔루션 »roboMark«가 작업 프로세스를 시작하기 전에, 사용자가 운영 소프트웨어의 팔레트 관리 기능을 통해 공구의 장착만 정의하면 됩니다. 다중 팔레트 시스템(기본 8개, 옵션으로 최대 9개까지 가능) 덕분에 대량의 제품을 완전 자동으로 처리하고 기록할 수 있습니다. 전반적으로 체계적으로 구성된 팔레트 관리는 공정 최적화에 크게 기여하며, 다양한 로트 크기를 유연하게 처리할 수 있게 하고, 제품을 보다 효율적이고 지속 가능한 방식으로 이동시키는 데 도움을 줍니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/c/csm_roboset2_palettenmanagement_abdb9924a8.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c232559",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "공정 모니터링용 카메라",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>옵션으로 제공되는 내장 카메라를 통해, 발생할 수 있는 이상 현상을 ZOLLER 서비스 담당자가 더 빠르고 정확하게 해결할 수 있습니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/f/7/csm_roboset2_kamera_c390857aa8.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c232511",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "»roboClean«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>선행 공정인 공구 절삭면 세정 공정 »roboClean«에서는 사전 세정된 샤프트 공구의 절삭면을 초음파 세척조를 통해 완전 자동으로 세정합니다. 이 과정에서 공구의 기름기를 제거하고 먼지를 털어내어, 후속 레이저 가공을 위한 최적의 조건을 조성합니다. 이후 에어 노즐을 통해 샤프트 공구의 건조가 이루어집니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/e/b/csm_roboset2_roboclean_3f8cc2b8bb.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c232463",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "용접부 탐지 – 옵션",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>설비 내에서 자동 비접촉식 웰던 인식이 이루어집니다. 공구는 로봇이 안전하게 집어 올릴 수 있도록 적절히 정렬되며, »roboMark«를 사용하여 적절한 위치에 마킹이 수행됩니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/5/8/csm_roboset2_weldon_13796999e5.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c232367",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "위원회 목록",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>공정 중에 오류 상태가 발생한 공구를 보관하는 곳.</p>",
          "images": [],
          "videos": [],
          "pos": "text",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c233394",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "QR 코드 인식",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>자동 공구 인식 기능에서는 내장된 스캐너를 통해 QR 코드, 데이터매트릭스 코드 등을 판독합니다. ZOLLER TMS Tool Management Solutions와의 인터페이스를 통해 스캔된 공구의 모든 정보를 확인할 수 있으며, 외부 작업장(예: 재연마 카운터)과의 연동도 구현할 수 있습니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/e/d/csm_roboset2_qrcode_c4865ddc90.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
