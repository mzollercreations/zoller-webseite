  {
   "type": "cols",
   "layout": "33-66",
   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> 기능성 </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c232727",
      "bg": "",
