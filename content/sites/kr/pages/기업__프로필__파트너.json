           "after": "default"
          }
         }
        ]
       },
       {
        "title": "지멘스 인더스트리 소프트웨어 GmbH",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>지멘스 디지털 팩토리(Siemens Digital Factory) 사업부의 한 사업부인 지멘스 PLM 소프트웨어(Siemens PLM Software)는 제품 수명 주기 관리(PLM) 및 제조 운영 관리(MOM)를 위한 소프트웨어, 시스템 및 서비스를 제공하는 세계적인 선도 기업으로, 전 세계적으로 1,500만 명 이상의 라이선스 사용자와 14만여 개의 고객사를 보유하고 있습니다.</p> <p>지멘스 소프트웨어 및 기술 파트너인 졸러(ZOLLER)는 지멘스 팀센터(Siemens Teamcenter)와의 인터페이스를 제공하여, 졸러의 설정·측정·검사 장비에서 공작 기계 및 제품 개발 및 제조용 통합 소프트웨어 제품군인 지멘스 NX(Siemens NX)로 목표값 및 실제값 데이터를 전송하고, 졸러 공구 데이터베이스 z.One을 통해 TMS(Tool Management Solutions)와 안전하게 데이터를 교환할 수 있도록 지원합니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/7/1/csm_logo_siemens_7bc6805809.webp",
            "alt": "",
            "w": 235,
            "h": 114
           }
          ],
          "videos": [],
          "pos": "above",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c2930",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "SOFLEX",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>SOFLEX는 독일에서 최초로 유연 생산 시스템을 도입했으며, 슈투트가르트 대학교의 스핀오프 기업으로서 처음부터 이 흥미롭고 도전적인 산업 분야에 발을 들여놓았습니다. 1984년부터 셀 및 생산 제어 시스템을 포함한 제어 시스템이 핵심 역량으로 자리잡았습니다. SOFLEX는 다양한 대학 및 고등 교육 기관과의 광범위한 네트워크를 통해 귀중한 자극을 얻고 있습니다.<br/><br/>ZOLLER 설정 및 측정 장비에는 SOFLEX와의 인터페이스가 포함되어 있어, 계획 작업이 ZOLLER 장비로 전송됩니다. 또한 이 설정 및 측정 장비는 ZOLLER-SOFLEX-PCS 인터페이스를 통해 공구 요구 목록을 완전히 자동으로 요청합니다. ZOLLER 설정 및 측정 장치에서 설정이 완료되면 측정된 데이터가 SOFLEX-PCS 시스템으로 직접 전송되며, 이후 SOFLEX-PCS는 공구를 기계에 장착할 때 공구 데이터를 기계로 전송합니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/1/3/csm_logo_soflex_01b48cd0dc.webp",
            "alt": "",
            "w": 246,
            "h": 72
           }
          ],
          "videos": [],
          "pos": "above",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c2931",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "솔리드캠(SolidCAM) GmbH",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>SolidCAM은 기계 제조, 전자, 의료, 소비재, 기계 개발, 자동차 및 항공우주 산업은 물론 금형 및 공구 제작 분야에서 효율적인 CAM 프로그래밍을 위한 통합 CAD/CAM 시스템의 세계적인 선도 기업 중 하나입니다. SolidCAM은 자사의 제품인 SolidCAM과 InventorCAM을 통해 SolidWorks 및 Autodesk Inventor와 원활하게 연동됩니다. 혁신적인 특허 기술인 iMachining과 SolidCAM MillTurn plus를 탑재한 이 소프트웨어는 복잡한 선반-밀링 센터 및 장형 선반에 이르기까지 모든 CNC 응용 분야를 지원합니다. 3개의 기술 센터를 포함한<br/>8개 지점에 75명 이상의 직원이 상주하여 독일 전역에 걸쳐 전문적인 사용자 지원과 최고 수준의 현장 기술 서비스를 보장합니다.<br/><br/>ZOLLER 공구 관리를 위한 간편하고 직관적인 SolidCAM 인터페이스는 TMS Tool Management Solutions를 통해 방대한 ZOLLER 공구 데이터베이스에 편리하게 접근할 수 있게 해줍니다. 밀링, 선반 가공 및 밀링-선반 복합 가공용 완제품 공구는 3D 공구 데이터 형태로 SolidCAM 내에서 직접 시뮬레이션 및 충돌 검사에 사용할 수 있습니다.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/8/csm_logo_solidcam_9711414196.webp",
