    [
     {
      "type": "textmedia",
      "header": "<h2> 인터페이스, 측정값, 연삭 휠, CNC용 공구 데이터 </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c728",
