      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">두 가지 모델, 풍부한 구성품 및 실용적인 옵션: 일상적인 사용에 최적화된 두 가지 길이의 공구와 액세서리 중에서 선택하세요. 고객님의 생산 현장에서의 개별적인 작업 흐름과 환경에 맞춰 설계되었습니다. 간편하고<br/><br/>명확하게 선택하시거나 저희에게 문의해 주십시오. 모델 선택과 혁신적인 다양한 옵션에 대해 기꺼이 상담해 드리겠습니다.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1109",
      "bg": "",
