  {
   "type": "product_header",
   "title": "»hobCheck«",
   "text": "<p>기어 가공 공구의 종합 검사를<br/>위한 범용 측정기</p> <p><a class=\"btn\" href=\"/kr/%EA%B8%B0%EC%97%85/%EC%97%B0%EB%9D%BD%EC%B2%98\">지금 문의하기</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/9/b/csm_hobCheck_header_6a4105ce8e.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
   "id": "c1605",
   "bg": "",
