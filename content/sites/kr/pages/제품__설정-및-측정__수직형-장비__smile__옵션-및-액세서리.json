     {
      "type": "textmedia",
      "header": "<h1> 옵션 및<br/> 액세서리 </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
