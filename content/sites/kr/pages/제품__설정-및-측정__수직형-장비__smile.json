  {
   "type": "hotspots",
   "header": "<h2> ZOLLER 품질을 완성하는 강력한 장점 </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/7/e/csm_smile_infodots_fc64de3107.webp",
