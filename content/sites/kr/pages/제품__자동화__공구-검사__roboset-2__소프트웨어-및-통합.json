       "before": "default",
       "after": "none"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">»pilot 4.0을« 사용하면 »roboSet 2가« 향후 작업에서 수행해야 할 모든 단계를 설정할 수 있습니다. 자동화 분야에서도 이 소프트웨어는 직관적인 조작 방식, 명확한 메뉴 구성, 큰 버튼, 그리고 사용자 맞춤형 인터페이스로 뛰어난 성능을 보여줍니다. 이를 통해 공구 검사를 신속하게 계획하고 시작할 수 있으며, 데이터를 간편하게 기록할 수 있습니다.</p>",
      "images": [],
      "videos": [],
