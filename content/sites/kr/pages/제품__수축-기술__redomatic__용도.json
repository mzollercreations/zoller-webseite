    [
     {
      "type": "textmedia",
      "header": "<h2> »pilot 4.0«이 이끄는 <br/>성공적인 공정 운영 </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "center",
      "ftype": "textmedia",
      "id": "c2462",
