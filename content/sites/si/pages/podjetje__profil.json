   "type": "hero",
   "slides": [
    {
     "img": "/fileadmin/_processed_/b/5/csm_header_zoller_profile_d86d616a1c.webp",
     "video": null,
     "title": "ZOLLER – inovativen, trdno zasidran in odprt za svet",
     "kicker": "",
     "text": "",
     "buttons": [],
