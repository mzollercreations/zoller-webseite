  },
  {
   "type": "textmedia",
   "header": "<h1> Pregled reznih robov z »mµFocus« – rešitev z natančnostjo 0,1 µm </h1>",
   "body": "<p>»mµFocus« brez dotika analizira pripravo reznih robov in hrapavost površine. Njegova ločljivost pri merjenju hrapavosti znaša 0,1 µm.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/b/4/csm_muefocus_infodots_01_823d7f4cd6.webp",
     "alt": "",
     "w": 1340,
     "h": 840
    }
   ],
   "videos": [],
