   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Pametne rešitve za skladiščenje in upravljanje </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
