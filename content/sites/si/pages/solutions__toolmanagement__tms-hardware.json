       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Želite z učinkovitim skladiščem orodja delati bolj produktivno in gospodarno? Potem so ZOLLER Smart Cabinets ravno prava rešitev za vas!</p> <p class=\"large-text\">Ponujamo vam ustrezno rešitev za skladiščenje, ne glede na to, ali želite upravljati z orodji in njihovimi komponentami, dodatki ali merilnimi in preskusnimi sredstvi. Zahvaljujoč povezavi s programsko opremo je mogoče celotno skladišče prikazati virtualno.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c163314",
   "bg": "",
   "space": {
    "before": "none",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/1/e/csm_josua_schade_9179cf0129.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">V podjetju ZOLLER prilagajamo strojno in programsko opremo potrebam uporabnikov. S tem ponujamo praktično usmerjene rešitve iz ene roke.</p> <p><strong>Josua Schade, upravljanje izdelkov TMS-Hardware</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/b/csm_sarah-michelle_wiacek_c4c06a6999.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Montažna ekipa podjetja ZOLLER v Pleidelsheimu v Nemčiji vsak dan da vse od sebe, da zagotovi nespremenjeno visoko kakovost vaših Smart Cabinets. Res je super biti del tega!</p> <p><strong>Sarah-Michelle Wiacek, ekipa za pripravo dela</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/0/9/csm_michael_haas_a5847acaff.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Z omaricami Smart Cabinets naši stranke ZOLLER ne le povečajo učinkovitost, temveč tudi preprečijo napake v tekočem proizvodnem procesu.</p> <p><strong>Michael Haas, prodaja ZOLLER Južna</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    }
   ],
