   },
   "spots": [
    {
     "x": 10.983,
     "y": 44.136,
     "label": "Večnamenski nabojnik za prijemalce",
     "text": "<h3>Večnamenski nabojnik za prijemalce</h3> <h4>Magazin za prijemalce – </h4> <p>ki lahko shrani do šest prijemal za različne obračalne ploščice.</p>"
    },
    {
     "x": 24.277,
     "y": 26.858,
     "label": "Agilen 6-osni robot",
     "text": "<h3>Agilen 6-osni robot</h3> <h4>6-osni robot – </h4> <p>proizvajalca Fanuc, s katerim se natančno menjajo obračalne rezalne ploščice in vijaki.</p>"
    },
    {
     "x": 47.451,
     "y": 11.907,
     "label": "Vgrajen magazin za zamenljive rezalne ploščice",
     "text": "<h3>Vgrajen magazin za zamenljive rezalne ploščice</h3> <h4>Magazin za obračalne rezalne ploščice – </h4> <p>ponuja dovolj prostora. Dva magazina znotraj »micBoxa« se lahko različno opremita.</p>"
    },
    {
     "x": 61.009,
     "y": 37.869,
     "label": "Vgrajena mazalna enota",
     "text": "<h3>Vgrajena mazalna enota</h3> <h4>Mazalna enota – </h4> <p>za vijake vsebuje posebno mazivo in zagotavlja enostavno odvijanje vijakov s pomočjo enote za vijake.</p>"
    },
    {
     "x": 54.598,
     "y": 50.045,
     "label": "Premična enota za vrtenje in obračanje",
     "text": "<h3>Premična enota za vrtenje in obračanje</h3> <h4>Enota za struženje in obračanje – </h4> <p>jo 6-osni robot opremi z obračalnimi rezili. To vstavljanje obračalnih rezil v enoto za vrtenje in obračanje s pomočjo 6-osnega robota poskrbi za ponovno usmeritev obračalnih rezil. S pomočjo magazina za vijake se po potrebi vedno uporabi nov vijak za orodje.</p>"
    },
    {
     "x": 54.808,
     "y": 64.548,
     "label": "Učinkovita enota za privijanje",
     "text": "<h3>Učinkovita enota za privijanje</h3> <h4>Vijačna enota – </h4> <p>z vgrajenim vakuumskim prijemalom, ki je nameščena na robotu in vedno zagotavlja natančno menjavo in privijanje vijakov s pravilnim navorom.</p>"
    },
    {
     "x": 38.886,
     "y": 66.338,
     "label": "Visoko natančen univerzalni vreten",
     "text": "<h3>Visoko natančen univerzalni vreten</h3> <h4>Univerzalni vreten – </h4> <p>omogoča namestitev orodij do 20 kg in omogoča tudi natančno pozicioniranje orodij v rotaciji.</p>"
    },
    {
     "x": 18.129,
     "y": 76.992,
     "label": "Zmogljiva programska oprema za krmiljenje",
     "text": "<h3>Zmogljiva programska oprema za krmiljenje</h3> <h4>Programska oprema za upravljanje – </h4> <p>zagotavlja popolno upravljanje »micBoxa«. Programsko opremo je mogoče prikazati tudi na zunanjih zaslonih.</p>"
    }
   ],
