  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Univerzalna tehnologija za preskušanje in merjenje<br/>za procesno usmerjeno pregledovanje orodij</p> <p><a class=\"btn\" href=\"/si/podjetje/kontakt\">Pošljite povpraševanje</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
   "id": "c1606",
   "bg": "",
