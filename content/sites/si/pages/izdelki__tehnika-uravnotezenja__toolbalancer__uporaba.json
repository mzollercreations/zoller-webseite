       {
        "title": "Optični pripomoček za vijačenje",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Grafični prikaz kotnega položaja vretena na zaslonu.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/1/2/csm_Optische_Eindrehhilfe_DE_74944f939a.webp",
