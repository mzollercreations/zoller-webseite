           "after": "default"
          }
         }
        ]
       },
       {
        "title": "lasersko označevanje",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Prikaz položaja neuravnoteženosti in korekcije na vpenjalniku z laserskim žarkom.</p>",
