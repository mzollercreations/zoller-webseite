   "images": [
    {
     "src": "/fileadmin/_processed_/7/e/csm_coraMachineLoad_info_roboter_d433b97337.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Cooperative robot unit",
     "caption": "<figcaption> <h3>Cooperative robot unit</h3> <p>»coraArm« robot unit - is responsible for the automated loading of the machine tool. The tools are provided via the ZOLLER »smartPallet system« and then inserted into the tool magazine by »coraArm«.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/6/f/csm_coraMachineLoad_info_smartpallet_a3008e4cc4.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Mobile »smartPallet system«",
     "caption": "<figcaption> <h3>Mobile »smartPallet system«</h3> <p>»smartPallet system«- for the provision of tools for automation systems. Thanks to the innovative pallet technology, tools can be reliably picked up and then transported manually or automatically to the various systems.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/1/b/csm_coraMachineLoad_info_sicherheit_1_284eeed4a8.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Intelligent safety device",
     "caption": "<figcaption> <h3>Intelligent safety device</h3> <p>»coraControl« safety device - provides the necessary safety zone for automated machine loading with the aid of the safety laser scanner and the EMERGENCY STOP switch. As an option, the work area can also be secured with a safety enclosure.</p> </figcaption>"
    }
   ],
