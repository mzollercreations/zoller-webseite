  {
   "type": "table",
   "header": "<h2> Teža pri postavitvi </h2>",
   "table": "<table> <tbody> <tr> <td> »mμFocus« s senzorjem »zep« in sistemom za vgradnjo pod mizo </td> <td> 250 kg </td> </tr> <tr> <td> »mμFocus« s senzorjem »zep-R« in sistemom za vgradnjo pod mizo </td> <td> 270 kg </td> </tr> <tr> <td> »mμFocus« s senzorjem »zep« brez sistema za vgradnjo pod mizo </td> <td> 75 kg </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c4147",
   "bg": "lightgray",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> »zep« senzor za merjenje geometrije rezila </h2>",
      "table": "<table> <tbody> <tr> <td> Os Z </td> <td> 300 mm </td> </tr> <tr> <td> AA (opisuje najmanjšo razdaljo med objektivom in merjenim predmetom) </td> <td> Projekcija črt3 </td> </tr> <tr> <td> Načelo merjenja </td> <td> 0 mm </td> </tr> <tr> <td> Najmanjši merljivi polmer </td> <td> 3 μm </td> </tr> <tr> <td> Numerična apertura </td> <td> – </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4149",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Senzor »zep-R« za merjenje 3D-geometrije rezila in hrapavosti površine </h2>",
      "table": "<table> <tbody> <tr> <td> Os Z </td> <td> 300 mm </td> </tr> <tr> <td> AA </td> <td> 20 mm </td> </tr> <tr> <td> Načelo merjenja </td> <td> Konfokalni mikroskop </td> </tr> <tr> <td> Najmanjši merljivi polmer </td> <td> 3 μm (vrednosti za objektiv s 20-kratno povečavo; vrednosti za objektiv s 50-kratno povečavo: 1,4 μm) </td> </tr> <tr> <td> Numerična apertura </td> <td> 0,42 mm </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4151",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c4148",
   "bg": "",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Hrapavost profila: izbira merljivih parametrov v skladu z ISO 4287 in ISO 13565 </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> aritmetična sredina po celotni dolžini merjenja </td> </tr> <tr> <td> Rq </td> <td> kvadratna sredina </td> </tr> <tr> <td> Rt </td> <td> skupna višina profila hrapavosti </td> </tr> <tr> <td> Rmax </td> <td> največja višina profila hrapavosti znotraj posameznega merilnega odseka </td> </tr> <tr> <td> Rz </td> <td> povprečna višina profila hrapavosti </td> </tr> <tr> <td> Rp </td> <td> višina največjega vrha v profilu hrapavosti </td> </tr> <tr> <td> Rv </td> <td> globina največjega profila v profilu hrapavosti </td> </tr> <tr> <td> Rk </td> <td> globina jedra, višina jedrnega območja </td> </tr> <tr> <td> Rpk </td> <td> zmanjšana višina vrha </td> </tr> <tr> <td> Rvk </td> <td> zmanjšana globina brazde </td> </tr> <tr> <td> Mr1 </td> <td> delež materiala nad jedrnim območjem (Abbottova krivulja) </td> </tr> <tr> <td> Mr2 </td> <td> delež materiala, ki nosi obremenitev (Abbottova krivulja) </td> </tr> <tr> <td> Rsm </td> <td> povprečna širina brazde </td> </tr> <tr> <td> RPc </td> <td> vrednost števila vrhov </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Hrapavost površine: Izbor merljivih parametrov v skladu z ISO 25178-2 in ISO 16610 </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> povprečna aritmetična višina površine z omejeno lestvico </td> </tr> <tr> <td> Sq </td> <td> povprečna kvadratna višina površine z omejeno lestvico </td> </tr> <tr> <td> Sp </td> <td> največja višina vrha površine z omejeno lestvico </td> </tr> <tr> <td> Sv </td> <td> največja višina doline površine z omejeno lestvico </td> </tr> <tr> <td> Sz </td> <td> največja višina površine z omejeno lestvico </td> </tr> <tr> <td> S10z </td> <td> deset-točkovna višina površine </td> </tr> <tr> <td> Ssk </td> <td> naklon površine z omejeno lestvico </td> </tr> <tr> <td> Sku </td> <td> kurtosis površine z omejeno lestvico </td> </tr> <tr> <td> Sdq </td> <td> povprečni kvadratni gradient površine z omejeno lestvico </td> </tr> <tr> <td> Sdr </td> <td> razvito razmerje prehodnih površin površine z omejeno lestvico </td> </tr> <tr> <td> FLT </td> <td> ravnost </td> </tr> <tr> <td> Sk </td> <td> višina jedra </td> </tr> <tr> <td> Spk </td> <td> zmanjšana višina vrha </td> </tr> <tr> <td> Svk </td> <td> zmanjšana višina doline </td> </tr> <tr> <td> Smr1 </td> <td> delež materiala na vrhovih </td> </tr> <tr> <td> Smr2 </td> <td> delež materiala v dolinah </td> </tr> <tr> <td> Vmc </td> <td> prostornina jedra površine z omejeno lestvico </td> </tr> <tr> <td> Vmp </td> <td> prostornina vrhov površine z omejeno lestvico </td> </tr> <tr> <td> Vvc </td> <td> prazna prostornina jedra površine z omejeno lestvico </td> </tr> <tr> <td> Vvv </td> <td> prazna prostornina dolin površine z omejeno lestvico </td> </tr> <tr> <td> Sxp </td> <td> ekstremna vrednost višine vrhov </td> </tr> <tr> <td> Str </td> <td> razmerje stranic teksture površine </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4141",
