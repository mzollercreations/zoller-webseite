   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> Pogosta vprašanja </h1>",
      "body": "<p>Pogosta vprašanja</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1037",
