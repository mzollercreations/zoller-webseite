    [
     {
      "type": "textmedia",
      "header": "<h2> Ne delamo izjem pri pravilih </h2>",
      "body": "<p class=\"large-text\">Etno in zakonito ravnanje je del naše korporativne kulture. To velja za stranke, poslovne partnerje, delničarje in zaposlene. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
