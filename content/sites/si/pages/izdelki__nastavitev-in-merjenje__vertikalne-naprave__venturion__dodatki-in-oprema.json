           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "merilni senzor",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Za taktilno merjenje rezil orodij.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/5/4/csm_option_messtaster_5313cb85ba.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3325",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "CNC-naprava za nagibanje",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Za merjenje brez popačenja orodij z naklonom, kot so orodja za rezanje navojev in valjčni rezkalniki.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/8/csm_option_cnc_schwenkeinrichtung_0fc04921b8.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3321",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Avtomatski sistem dolžinskih omejevalnikov »asza«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Linearni nastavljiv mehanizem s CNC-krmiljenjem za nastavitev dolžine orodja prek oporne palice. Na voljo je tudi različica »asza-rot«, pri kateri je mogoče dolžino orodja nastaviti po izbiri z avtomatskim vrtenjem vijaka za nastavitev dolžine (ne velja za skrčljive vpenjalne glave).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/1/csm_option_asza_32f127ae86.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3319",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Os Y na stolpu",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Zahvaljujoč dodatni osi Y je mogoče nosilec optike s CNC-krmiljenjem v smeri Y premakniti do ± 50 mm od središča vretena. V kombinaciji s kamero za merjenje središča vrtenja je tako mogoče učinkovito in zelo natančno izmeriti rezalna orodja in večfunkcijska orodja ter jih nastaviti na višino konice.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/3/6/csm_option_yachse_7a1e458de7.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3317",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Izvedba konjička »phoenix«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Konični nosilec se lahko enostavno spusti in natančno drži dolga, tanka orodja v določenem položaju z določeno pritiskno silo. Poleg orodij je mogoče med konicami meriti tudi sestavne dele.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/5/csm_option_reitstock_phoenix_249d45464d.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
