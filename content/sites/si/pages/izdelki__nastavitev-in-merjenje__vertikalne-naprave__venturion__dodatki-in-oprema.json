      "items": [
       {
        "title": "Ročno natančno nastavljanje",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Ročni gumbi za dodatno ročno natančno nastavitev osi Z in X, posebej za modul za pregled orodja.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/8/9/csm_option_feinverstellung_69e5b6735b.webp",
            "alt": "",
            "w": 1000,
