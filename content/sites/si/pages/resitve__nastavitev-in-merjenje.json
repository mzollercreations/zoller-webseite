    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>Kdor meri orodja vzporedno z glavnim delovnim časom CNC-stroja, dela učinkoviteje. </h3>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c614",
