  {
   "type": "product_header",
   "title": "Rešitve za orodja",
   "text": "<p>Nosilec orodja kot idealna povezava<br/>za vašo digitalno proizvodnjo</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Kupite zdaj</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/d/c/csm_header_tooling_79126defc9.webp",
    "alt": "",
    "w": 1428,
    "h": 896
   },
   "ftype": "zoller_product_header",
   "id": "c1416",
   "bg": "",
