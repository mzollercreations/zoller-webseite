    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Dva modela, obsežna oprema in praktične možnosti: izberite med dvema različnima dolžinama orodja in dodatki za optimalno vsakodnevno uporabo. Za popolnoma prilagojene delovne postopke in razmere v vaši proizvodnji.<br/><br/>Izberite enostavno in pregledno ali se obrnite na nas: z veseljem vam bomo svetovali pri izbiri modela in inovativni paleti možnosti.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1109",
      "bg": "",
