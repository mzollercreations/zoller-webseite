   }
  },
  {
   "type": "textmedia",
   "header": "<h2> Priključki za balansiranje (ostali na zahtevo) </h2>",
   "body": "<figure><table><tbody><tr><td>Priključek za uravnoteženje SK 30/40/50</td></tr><tr><td>Adapter za uravnoteženje HSK 32/40/50/63/80/100 (A/C/E-B/D/F)</td></tr><tr><td>Adapter za uravnoteženje PSC C 32/40/50/63/80</td></tr></tbody></table></figure>",
