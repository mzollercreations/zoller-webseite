        "title": "Odlično organizirano",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Vse posamezne komponente, kompletna orodja in nastavitvene liste vnesite v centralno bazo podatkov.</p>",
          "images": [],
          "videos": [],
          "pos": "text",
