          "valign": "top",
          "ftype": "textpic",
          "id": "c1544",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Ročna postaja za pisanje in branje RFID »mslz«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Za ročno zapisovanje/branje nosilca kode na držalu orodja z ročnim čitalnikom.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/a/f/csm_option_rfid_34dfe1d75c.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c1542",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "napajalnik z brezprekinitvenim napajanjem",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Napajalnik UPS za neprekinjeno napajanje v primeru motenj v električnem omrežju zagotavlja, da se vaš računalnik pravilno izklopi, s čimer se prepreči izguba podatkov. Na voljo so napetosti 230 V~ (Evropa) oziroma 120 V~ (ZDA).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/2/csm_option_usv_4c4cb5d571.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c1540",
          "bg": "",
          "space": {
