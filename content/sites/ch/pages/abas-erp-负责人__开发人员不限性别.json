     {
      "type": "textmedia",
      "header": "<h3> IT系统部门 </h3> <h1> abas ERP 负责人/开发人员（不限性别） </h1>",
      "body": "<p><a href=\"/fileadmin/01_Pages/Company/Career/DE/abas_ERPBetreuer_2026_05_07_ZOLLER.pdf\" rel=\"noopener\" target=\"_blank\">职位招聘信息下载（PDF）</a></p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c90840",
