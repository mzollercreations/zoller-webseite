     },
     {
      "type": "textmedia",
      "header": "",
      "body": "",
      "images": [
       {
        "src": "/fileadmin/_processed_/3/e/csm_ZollerMediaZNU6_6a196df78d.webp",
        "alt": "",
        "w": 900,
        "h": 319
       }
      ],
