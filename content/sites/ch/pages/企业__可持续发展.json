     {
      "type": "textmedia",
      "header": "",
      "body": "<h2>ZOLLER 的多元化：<br/>位于普莱德尔斯海姆总部的团队成员来自 24 个国家</h2>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
