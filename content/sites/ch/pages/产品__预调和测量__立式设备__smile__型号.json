       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">ZOLLER »smile« 入门级机型配备高品质的品牌组件，并提供 »pilotBasic«、»pilotStarter« 和 »pilot 2 mT« 三种测量设备软件版本。您无需经过培训，即可立即获得精准的测量结果。 该系列产品非常适合所有标准刀具，专为中小批量生产的需求而设计。设备坚固耐用、节省空间，可灵活放置在 CNC 机床旁、车间内或生产单元中。</p> <p class=\"large-text\">简而言之 — »smileCompact« 是您进入 ZOLLER 世界的理想入门之选。</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3494",
