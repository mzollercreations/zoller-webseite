   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> 入门级紧凑型设备 </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c3493",
