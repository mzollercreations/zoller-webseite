           "after": "default"
          }
         }
        ]
       },
       {
        "title": "单面动平衡",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>用于测量和补偿单平面（静态）中的不平衡。</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/f/6/csm_Wuchten_in_1_Ebene_DE_23e1e800e4.webp",
