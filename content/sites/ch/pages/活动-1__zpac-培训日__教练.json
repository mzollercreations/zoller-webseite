    {
     "img": "/fileadmin/_processed_/8/e/csm_csm_meet_zoller_599fe3f5ee_b8eb9cad0a.webp",
     "video": null,
     "title": "专家访谈",
     "kicker": "",
     "text": "<p>ZOLLER 开放日暨自动化峰会</p>",
     "buttons": [],
