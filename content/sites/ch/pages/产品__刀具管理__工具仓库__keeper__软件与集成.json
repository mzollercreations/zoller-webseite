   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> 软件 </h1>",
      "body": "<p class=\"large-text\">智能柜</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3707",
      "bg": "",
