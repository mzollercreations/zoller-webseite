  {
   "type": "textmedia",
   "header": "<h1> 技术参数 </h1>",
   "body": "",
   "images": [],
   "videos": [],
   "pos": "text",
   "cols": 1,
   "valign": "top",
   "ftype": "text",
   "id": "c4144",
   "bg": "",
   "space": {
    "before": "default",
    "after": "small"
   }
  },
  {
   "type": "table",
   "header": "<h2> 安装重量 </h2>",
   "table": "<table> <tbody> <tr> <td> 配备 »zep« 传感器和台下安装系统的 »mμFocus« </td> <td> 250 kg </td> </tr> <tr> <td> 配备 »zep-R« 传感器和台下安装系统的 »mμFocus« </td> <td> 270 kg </td> </tr> <tr> <td> 配备 »zep« 传感器但不带台下安装系统的 »mμFocus« </td> <td> 75 kg </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c4147",
   "bg": "lightgray",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> »zep« 刀具刃口几何形状测量传感器 </h2>",
      "table": "<table> <tbody> <tr> <td> Z轴 </td> <td> 300 毫米 </td> </tr> <tr> <td> AA（指镜头与被测物体之间的最小距离） </td> <td> 条纹投影3 </td> </tr> <tr> <td> 测量原理 </td> <td> 0 毫米 </td> </tr> <tr> <td> 最小可测半径 </td> <td> 3 微米 </td> </tr> <tr> <td> 数值孔径 </td> <td> – </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4149",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> »zep-R« 传感器，用于测量3D切削刃几何形状和表面粗糙度 </h2>",
      "table": "<table> <tbody> <tr> <td> Z轴 </td> <td> 300 毫米 </td> </tr> <tr> <td> AA </td> <td> 20 mm </td> </tr> <tr> <td> 测量原理 </td> <td> 共聚焦显微镜 </td> </tr> <tr> <td> 最小可测半径 </td> <td> 3 μm（20倍物镜；50倍物镜：1.4 μm） </td> </tr> <tr> <td> 数值孔径 </td> <td> 0.42 mm </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4151",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c4148",
   "bg": "",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> 轮廓粗糙度：根据 ISO 4287 和 ISO 13565 标准选择可测量的参数 </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> 整个测量长度的算术平均值 </td> </tr> <tr> <td> Rq </td> <td> 平方平均值 </td> </tr> <tr> <td> Rt </td> <td> 粗糙度轮廓的总高度 </td> </tr> <tr> <td> Rmax </td> <td> 单个测量段内粗糙度轮廓的最大高度 </td> </tr> <tr> <td> Rz </td> <td> 粗糙度轮廓的平均高度 </td> </tr> <tr> <td> Rp </td> <td> 粗糙度轮廓中最大峰值的高度 </td> </tr> <tr> <td> Rv </td> <td> 粗糙度轮廓中最大谷值的深度 </td> </tr> <tr> <td> Rk </td> <td> 核心粗糙度深度，即核心区域的高度 </td> </tr> <tr> <td> Rpk </td> <td> 峰值高度的折算值 </td> </tr> <tr> <td> Rvk </td> <td> 沟槽深度的折算值 </td> </tr> <tr> <td> Mr1 </td> <td> 核心区域上方的材料占比（阿博特曲线） </td> </tr> <tr> <td> Mr2 </td> <td> 承重材料占比（阿博特曲线） </td> </tr> <tr> <td> Rsm </td> <td> 平均沟槽宽度 </td> </tr> <tr> <td> RPc </td> <td> 峰值计数值 </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> 表面粗糙度：根据 ISO 25178-2 和 ISO 16610 标准选择可测量的参数 </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> 尺度限定表面的算术平均高度 </td> </tr> <tr> <td> Sq </td> <td> 尺度限定表面的均方高度 </td> </tr> <tr> <td> Sp </td> <td> 尺度限定表面的最大峰值高度 </td> </tr> <tr> <td> Sv </td> <td> 尺度限定的表面最大凹高 </td> </tr> <tr> <td> Sz </td> <td> 尺度限定的表面最大高度 </td> </tr> <tr> <td> S10z </td> <td> 表面的十点高度 </td> </tr> <tr> <td> Ssk </td> <td> 尺度限定的表面偏斜度 </td> </tr> <tr> <td> Sku </td> <td> 尺度限制表面的峰度 </td> </tr> <tr> <td> Sdq </td> <td> 尺度限制表面的均方梯度 </td> </tr> <tr> <td> Sdr </td> <td> 尺度限制表面的展开过渡面比 </td> </tr> <tr> <td> FLT </td> <td> 平整度 </td> </tr> <tr> <td> Sk </td> <td> 芯高 </td> </tr> <tr> <td> Spk </td> <td> 简化峰高 </td> </tr> <tr> <td> Svk </td> <td> 简化谷高 </td> </tr> <tr> <td> Smr1 </td> <td> 峰部材料占比 </td> </tr> <tr> <td> Smr2 </td> <td> 谷部材料占比 </td> </tr> <tr> <td> Vmc </td> <td> 尺度化表面的核心材料体积 </td> </tr> <tr> <td> Vmp </td> <td> 尺度化表面的峰部材料体积 </td> </tr> <tr> <td> Vvc </td> <td> 尺度有限表面核心的空隙体积 </td> </tr> <tr> <td> Vvv </td> <td> 尺度有限表面谷部的空隙体积 </td> </tr> <tr> <td> Sxp </td> <td> 峰高极值 </td> </tr> <tr> <td> Str </td> <td> 表面纹理的宽高比 </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4141",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
   ],
