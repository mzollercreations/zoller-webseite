  {
   "type": "textmedia",
   "header": "<h1> 始于解决方案，智启高效系统 </h1>",
   "body": "",
   "images": [],
   "videos": [],
   "pos": "text",
   "cols": 1,
   "valign": "top",
   "ftype": "textmedia",
   "id": "c7411",
