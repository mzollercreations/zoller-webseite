  {
   "type": "table",
   "header": "<h2> 应用 </h2>",
   "table": "<table> <tbody> <tr> <td> 2D参数 入射光 </td> <td> </td> <td> </td> </tr> <tr> <td> 标准直径 2–100 mm </td> <td> 基本配置 </td> <td> </td> </tr> <tr> <td> 微型刀具 0.1–10 mm </td> <td> 可选 </td> <td> </td> </tr> <tr> <td> 3D参数 入射光 </td> <td> </td> <td> </td> </tr> <tr> <td> 局部 </td> <td> 基本配置 </td> <td> </td> </tr> <tr> <td> 面积 </td> <td> 基本配置 </td> <td> </td> </tr> <tr> <td> 测量任务 </td> <td> </td> <td> </td> </tr> <tr> <td> 切削刃钝化 </td> <td> 可选 </td> <td> </td> </tr> <tr> <td> 粗糙度 </td> <td> 可选 </td> <td> </td> </tr> <tr> <td> 螺纹刀具 </td> <td> 可选 </td> <td> </td> </tr> </tbody> </table>",
