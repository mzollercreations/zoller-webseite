  {
   "type": "product_header",
   "title": "»hobCheck«",
   "text": "<p>用于全面检测齿轮刀具的通用测量机</p> <p><a class=\"btn\" href=\"/ch/%E4%BC%81%E4%B8%9A/%E8%81%94%E7%B3%BB%E6%88%91%E4%BB%AC\">立即咨询</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/9/b/csm_hobCheck_header_6a4105ce8e.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
