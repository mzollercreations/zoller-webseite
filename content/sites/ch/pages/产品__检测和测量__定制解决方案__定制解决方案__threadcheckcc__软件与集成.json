          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "排屑槽空间扫描",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>自动、非接触式扫描槽/排屑槽轮廓，并以图形形式显示。</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/2/c/csm_software_nutscan_4a0f6866e5.webp",
