   "images": [
    {
     "src": "/fileadmin/_processed_/7/e/csm_coraMachineLoad_info_roboter_d433b97337.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "协作机器人单元",
     "caption": "<figcaption> <h3>协作机器人单元</h3> <p>»»coraArm«« 机器人单元——负责机床的自动装载。刀具通过 ZOLLER »»smartPallet«« 系统进行供应，随后由 »»coraArm«« 将其装入刀具库中。</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/6/f/csm_coraMachineLoad_info_smartpallet_a3008e4cc4.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "»smartPallet«移动»系统«",
     "caption": "<figcaption> <h3>»smartPallet«移动»系统«</h3> <p>»»smartPallet«系统«——专为自动化设备的刀具供应而设计。凭借创新的托盘技术，该系统能够可靠地存放刀具，并随后通过手动或自动方式将其输送至各类设备。</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/1/b/csm_coraMachineLoad_info_sicherheit_1_284eeed4a8.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "智能安全装置",
     "caption": "<figcaption> <h3>智能安全装置</h3> <p>»»coraControl«« 安全装置——借助安全激光扫描仪和紧急停止开关，在自动化机器装载过程中确保必要的安全区域。此外，还可选择性地通过安全防护罩对工作区域进行额外保护，或仅使用安全防护罩进行保护。</p> </figcaption>"
    }
   ],
