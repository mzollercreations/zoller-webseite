       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Vill ni arbeta mer produktivt och kostnadseffektivt med ett effektivt verktygslager? Då är ZOLLER Smart Cabinets precis rätt för er!</p> <p class=\"large-text\">Vi erbjuder den rätta lagerlösningen, oavsett om du vill hantera verktyg och deras komponenter, tillbehör eller mät- och provningsutrustning. Tack vare programvaruanslutningen kan hela lagret visas virtuellt.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c163314",
   "bg": "",
   "space": {
    "before": "none",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/1/e/csm_josua_schade_9179cf0129.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Hos ZOLLER anpassar vi hårdvara och mjukvara efter användarens behov. På så sätt erbjuder vi praktiskt inriktade lösningar från en och samma leverantör.</p> <p><strong>Josua Schade, produktledning TMS-hårdvara</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/b/csm_sarah-michelle_wiacek_c4c06a6999.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">ZOLLER:s monteringsteam i Pleidelsheim, Tyskland, ger varje dag sitt yttersta för att säkerställa en jämn och hög kvalitet på era Smart Cabinets. Det är helt enkelt fantastiskt att vara en del av detta!</p> <p><strong>Sarah-Michelle Wiacek, teamet för arbetsförberedelse</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/0/9/csm_michael_haas_a5847acaff.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Med Smart Cabinets ökar våra ZOLLER-kunder inte bara effektiviteten utan undviker också fel i den löpande tillverkningsprocessen.</p> <p><strong>Michael Haas, försäljning ZOLLER Syd</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    }
   ],
