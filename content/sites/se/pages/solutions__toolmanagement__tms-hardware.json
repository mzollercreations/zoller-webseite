   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Smarta lager- och administrationslösningar </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163290",
