  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Universell mät- och kontrollteknik för verktyg</p> <p><a class=\"btn\" href=\"/se/foeretag/kontakt\">Begär information nu</a></p>",
   "img": {
