  {
   "type": "product_header",
   "title": "»pomBasic«",
   "text": "<p>Processorienterade kompakta lösningar<br/>för verktygskontroll</p> <p><a class=\"btn\" href=\"/se/foeretag/kontakt\">Begär offert nu</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/9/csm_pomBasic_header_e15bc565eb.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
