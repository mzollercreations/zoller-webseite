  {
   "type": "hotspots",
   "header": "<h2> Goda skäl att välja ZOLLER:s kvalitet </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/7/e/csm_smile_infodots_fc64de3107.webp",
    "alt": "",
    "w": 1200,
