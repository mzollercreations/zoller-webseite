   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> Vanliga frågor </h1>",
      "body": "<p>Vanliga frågor</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
