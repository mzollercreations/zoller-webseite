  {
   "type": "cols",
   "layout": "33-66",
   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Programvara </h2>",
      "body": "<h4>För maximal prestanda</h4>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1503",
