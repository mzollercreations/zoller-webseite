     {
      "type": "textmedia",
      "header": "<h3> Område IT-system </h3> <h1> abas ERP-supporttekniker/-utvecklare (m/k/d) </h1>",
      "body": "<p><a href=\"/fileadmin/01_Pages/Company/Career/DE/abas_ERPBetreuer_2026_05_07_ZOLLER.pdf\" rel=\"noopener\" target=\"_blank\">Lediga tjänster att ladda ner (pdf)</a></p>",
