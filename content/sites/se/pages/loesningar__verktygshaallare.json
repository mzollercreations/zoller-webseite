  {
   "type": "product_header",
   "title": "Verktygslösningar",
   "text": "<p>Verktygshållare – den perfekta länken<br/>till din digitala tillverkning</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Köp nu</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/d/c/csm_header_tooling_79126defc9.webp",
    "alt": "",
    "w": 1428,
    "h": 896
   },
   "ftype": "zoller_product_header",
   "id": "c1416",
   "bg": "",
