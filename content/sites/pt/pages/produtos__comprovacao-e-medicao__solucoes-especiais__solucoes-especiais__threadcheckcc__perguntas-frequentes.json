    [
     {
      "type": "textmedia",
      "header": "<h1> Perguntas frequentes </h1>",
      "body": "<p>Perguntas frequentes</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1720",
