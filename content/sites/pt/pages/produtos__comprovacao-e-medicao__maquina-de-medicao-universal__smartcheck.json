  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Tecnologia universal de teste e medição<br/>para uma inspeção de ferramentas orientada para o processo</p> <p><a class=\"btn\" href=\"/pt/empresa/contacto\">Solicitar agora</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
