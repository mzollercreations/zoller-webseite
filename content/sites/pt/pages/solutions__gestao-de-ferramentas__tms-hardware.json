       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Quer trabalhar de forma mais produtiva e económica com um armazém de ferramentas eficiente? Então os armários inteligentes da ZOLLER são a solução ideal para si!</p> <p class=\"large-text\">Oferecemos a solução de armazenamento adequada, independentemente se pretende gerir ferramentas e os seus componentes, acessórios ou instrumentos de verificação e medição. Graças à ligação ao software, é possível realizar a representação virtual de todo o armazém.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
