    [
     {
      "type": "textmedia",
      "header": "<h2> Não fazemos exceções às regras. </h2>",
      "body": "<p class=\"large-text\">Agir de forma ética e legal faz parte da nossa cultura corporativa. Isso aplica-se a clientes, parceiros comerciais, acionistas e funcionários. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c26285",
