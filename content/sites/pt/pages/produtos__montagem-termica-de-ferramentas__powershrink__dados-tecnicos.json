   "type": "table",
   "header": "",
   "table": "<table> <tbody> <tr> <td> </td> <td class=\"text-center\"> »powerShrink 200« </td> <td class=\"text-center\"> »powerShrink 300« </td> <td class=\"text-center\"> »powerShrink 400« </td> <td class=\"text-center\"> »powerShrink 600« </td> </tr> <tr> <td> Comprimento da ferramenta retrátil </td> <td class=\"text-center\"> 400 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> </tr> <tr> <td> Diâmetro interno máximo da bobina de indução com sistema de blindagem varOct </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 45,8 mm </td> <td class=\"text-center\"> 45,8 mm </td> <td class=\"text-center\"> 45,8 mm </td> </tr> <tr> <td> Diâmetro interno máximo da bobina de indução com discos de blindagem </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> </tr> <tr> <td> Diâmetros retráteis com bobina de indução de 14 kVA </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> </tr> <tr> <td> Diâmetros de retração com bobina de indução de 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 16–50 mm </td> </tr> <tr> <td> Valores de ligação </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Valores de ligação pneumáticos </td> <td class=\"text-center\"> 6–8 bar </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 6–8 bar </td> </tr> <tr> <td> Parâmetros de ligação elétrica </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> </tr> <tr> <td> Cabo de alimentação </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> </tr> <tr> <td> Potência de ligação do sistema de retracção por indução 14 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> </tr> <tr> <td> Potência de ligação do sistema de retracção por indução 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 23 kVA </td> </tr> <tr> <td> Pesos </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Sem sistema de arrefecimento, arrefecimento por ar por baixo da bobina de indução </td> <td class=\"text-center\"> ~ 35 kg </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Versão de bancada, zStream </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 150 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Versão de bancada, campânulas de refrigeração,<br/> peso adicional do refrigerador a água </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 143 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ~ 153 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Com mesa inferior, zStream </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 240 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Com mesa inferior, campânulas de refrigeração </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 274 kg </td> <td class=\"text-center\"> ~ 284 kg </td> <td class=\"text-center\"> ~ 410 kg </td> </tr> </tbody> </table>",
