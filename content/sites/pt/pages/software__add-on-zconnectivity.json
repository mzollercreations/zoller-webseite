   "table": "<table> <tbody> <tr> <td> </td> <td class=\"text-center\"> Navegador da Web </td> <td class=\"text-center\"> Desktop </td> </tr> <tr> <td> »zidCode«* </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Software »zidCode«* </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ● </td> </tr> <tr> <td> »zidCode 4.0«* </td> <td class=\"text-center\"> ● </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> »z.Stats«* </td> <td class=\"text-center\"> ● </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Gestão da vida útil (tecnologia RFID/tecnologia »z.DMI«) </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ● </td> </tr> <tr> <td> Monitorização da vida útil »flash« (tecnologia »z.DMI«) </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ● </td> </tr> <tr> <td> Pós-processadores </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ● </td> </tr> <tr> <td> Consulta do magazine </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ● </td> </tr> <tr> <td> Entrada de dados/Saída de dados/DNC, incluindo gerador de formatos </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ● </td> </tr> </tbody> </table>",
