    "after": "small"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2 class=\"headline-decor\"> Maior produtividade </h2>",
   "body": "<p class=\"large-text\">A paragem das máquinas é dispendiosa e desnecessária. Quando as ferramentas chegam pré-ajustadas à máquina, pode iniciar mais cedo com o próximo pedido|encomenda. Maximize agora a sua produtividade com um dispositivo de ajuste e medição da ZOLLER.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/e/5/csm_presetting_02_f4a2e05503.webp",
     "alt": "",
     "w": 1220,
     "h": 1250
    }
   ],
   "videos": [],
   "pos": "right",
   "cols": 1,
   "valign": "center",
   "ftype": "textmedia",
   "id": "c619",
   "bg": "white",
