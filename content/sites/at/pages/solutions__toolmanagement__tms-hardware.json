       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Sie wollen mit einem effizienten Werkzeuglager produktiver und wirtschaftlicher arbeiten? Dann sind die ZOLLER Smart Cabinets genau das Richtige für Sie!</p> <p class=\"large-text\">Wir bieten die passende Lagerlösung, egal, ob Sie Werkzeuge und deren Komponenten, Zubehör oder Mess- und Prüfmittel verwalten möchten. Dank Softwareanbindung lässt sich das gesamte Lager virtuell darstellen.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c163314",
   "bg": "",
