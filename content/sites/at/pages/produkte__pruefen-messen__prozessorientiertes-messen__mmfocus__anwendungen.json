   "images": [
    {
     "src": "/fileadmin/_processed_/4/9/csm_muefocus_anwendung_01_6748a607d4.webp",
     "alt": "",
     "w": 633,
     "h": 399,
     "title": "Nur eine Minute",
     "caption": "<figcaption> <h3>Nur eine Minute</h3> <p>Innerhalb rund einer Minute erfasst »mµFocus« alle Bilddaten, die für die Visualisierung in 3D erforderlich sind. Kurze, präzise Messzyklen für Stichproben und Chargen.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/2/7/csm_muefocus_anwendung_02_20dad0de12.webp",
     "alt": "",
     "w": 633,
     "h": 399,
     "title": "Nur ein Gerät",
     "caption": "<figcaption> <h3>Nur ein Gerät</h3> <p>»mµFocus« steht für effiziente Prozesse in der Qualitätssicherung. In der Ausstattung mit »zep-R«-Sensor prüfen Sie mit nur einem Gerät Schneidkantenverrundung und Oberflächenrauheit.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/1/f/csm_muefocus_anwendung_03_ca7082affd.webp",
     "alt": "",
     "w": 633,
     "h": 399,
     "title": "Nur bei ZOLLER",
     "caption": "<figcaption> <h3>Nur bei ZOLLER</h3> <p>Das Herz von »mµFocus« ist die berührungslose Sensortechnologie mit Laser und optionaler konfokaler Mikroskopie. Die Sensorik wurde von uns entwickelt und gibt es nur in den Geräten von ZOLLER.</p> </figcaption>"
    }
   ],
