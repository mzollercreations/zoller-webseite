     {
      "type": "textmedia",
      "header": "<h1> FAQ </h1>",
      "body": "<p class=\"large-text\">Häufig gestellte Fragen</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
