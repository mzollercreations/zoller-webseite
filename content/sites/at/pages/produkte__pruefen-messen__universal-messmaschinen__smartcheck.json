  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Universelle Prüf- und Messtechnik <br/>für eine prozessorientierte Werkzeuginspektion</p> <p><a class=\"btn\" href=\"/at/unternehmen/kontakt\">Jetzt anfragen</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
