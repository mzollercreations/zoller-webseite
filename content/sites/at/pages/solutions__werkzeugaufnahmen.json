  {
   "type": "product_header",
   "title": "Tooling Solutions",
   "text": "<p>Werkzeughalter als perfekte Schnittstelle <br/>für Ihre digitale Fertigung</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Jetzt kaufen</a></p>",
   "img": {
