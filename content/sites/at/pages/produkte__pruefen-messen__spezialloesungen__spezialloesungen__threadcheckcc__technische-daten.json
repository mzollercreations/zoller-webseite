   "table": "<table> <tbody> <tr> <td> 2D-Parameter Auflicht </td> <td> </td> </tr> <tr> <td> Durchmesser Standard 2–100 mm </td> <td> Basis </td> </tr> <tr> <td> Mikrowerkzeuge 0,1–10 mm </td> <td> optional </td> </tr> <tr> <td> 3D-Parameter Auflicht </td> <td> </td> </tr> <tr> <td> Partiell </td> <td> Basis </td> </tr> <tr> <td> Flächenbezogen </td> <td> Basis </td> </tr> <tr> <td> Messaufgaben </td> <td> </td> </tr> <tr> <td> Gewindewerkzeuge </td> <td> Basis </td> </tr> <tr> <td> Verzahnungswerkzeuge </td> <td> optional </td> </tr> </tbody> </table>",
