   "table": "<table> <tbody> <tr> <td> Optik-Durchlicht </td> <td> </td> </tr> <tr> <td> Durchlichtkamera HR70, BF ca. 4,0 x 3,6 mm² </td> <td> Basis </td> </tr> <tr> <td> Durchlichtkamera 5 Mpx, BF ca. 4,4 x 4,0 mm² </td> <td> optional </td> </tr> <tr> <td> Durchlichtkamera WF, BF ca. 15,5 x 14,1 mm² </td> <td> optional </td> </tr> <tr> <td> Optik-Auflicht </td> <td> </td> </tr> <tr> <td> Auflichtkamera HR50 Standard, BF ca. 1,1 x 1,0 mm² </td> <td> Basis </td> </tr> <tr> <td> Auflichtkamera HR50 Micro, BF ca. 0,4 x 0,4 mm² </td> <td> optional </td> </tr> <tr> <td> Taktil </td> <td> </td> </tr> <tr> <td> Scannender Messtaster </td> <td> optional </td> </tr> <tr> <td> Schaltender Messtaster </td> <td> optional </td> </tr> <tr> <td> Werkzeugidentifikation </td> <td> </td> </tr> <tr> <td> RFID Manuell »mslz« </td> <td> optional </td> </tr> </tbody> </table>",
