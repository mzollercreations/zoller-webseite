  {
   "type": "product_header",
   "title": "»mµFocus«",
   "text": "<p>Der Analytiker für die feinsten <br/>Strukturen eines Werkzeugs</p> <p><a class=\"btn\" href=\"/at/unternehmen/kontakt\">Jetzt anfragen</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/8/csm_myFocus_header_de2cb108cf.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
