    {
     "src": "/fileadmin/_processed_/b/8/csm_bestueckung_6fach_9ae3d33bd9.webp",
     "alt": "",
     "w": 633,
     "h": 398,
     "title": "Bestückung D 745 – 6&#8209;fach Teilung",
     "caption": "<figcaption> <h3>Bestückung D 745 – 6‑fach Teilung</h3> <p>Für verschiedene Werkzeugaufnahmen. Durch Drehen des Revolvertisches hat der Anwender immer die richtige Werkzeugaufnahme im Messbereich.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/0/9/csm_bestueckung_8fach_adda36b1c6.webp",
     "alt": "",
     "w": 633,
     "h": 398,
     "title": "Bestückung D 745 – 8&#8209;fach Teilung",
     "caption": "<figcaption> <h3>Bestückung D 745 – 8‑fach Teilung</h3> <p>Für vier Universalaufnahmen HGH-UZ, zwei Grundaufnahmen GA-PP und zwei Grundaufnahmen GA. Die Anzahl der einsetzbaren Adapter und Vorsatzhalter ist nahezu unbegrenzt.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/5/7/csm_bestueckung_12fach_ee5625722e.webp",
     "alt": "",
     "w": 633,
     "h": 398,
     "title": "Bestückung D 900 – 12&#8209;fach Teilung",
     "caption": "<figcaption> <h3>Bestückung D 900 – 12‑fach Teilung</h3> <p>Universalaufnahme HGH-UZ für drehende und<br/> stehende Werkzeuge – zusätzlich sind spezielle Werkzeugaufnahmen für Göltenbodt, Schütte, Traub, Index und andere montierbar.</p> </figcaption>"
    }
   ],
