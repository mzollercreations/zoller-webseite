   "images": [
    {
     "src": "/fileadmin/_processed_/4/0/csm_roboBox_info_Ein-Ausgabemodul_7e6416b756.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Hochmodernes Ein-/Ausgabemodul",
     "caption": "<figcaption> <h3>Hochmodernes Ein-/Ausgabemodul</h3> <p>Ein-/Ausgabemodul für das »smartPallet«-System – dient der sicheren Aufnahme Ihrer Werkzeugpaletten. Die Werkzeugpaletten können entweder mit dem manuellen Palettenwagen oder dem fahrerlosen Transportsystem »coraExpress« angeliefert werden.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/e/7/csm_roboBox_info_Roboterbasismodul_3a24db0e88.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Intelligentes Roboterbasismodul",
     "caption": "<figcaption> <h3>Intelligentes Roboterbasismodul</h3> <p>Roboterbasismodul – bei dem der FANUC 6-Achs- Knickarmroboter die Werkzeuge greift und zuverlässig zwischen den verschiedenen Modulen transportiert.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/1/a/csm_roboBox_info_Montagemodule_c2aef185f8.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Innovative Montagemodule",
     "caption": "<figcaption> <h3>Innovative Montagemodule</h3> <p>Montagemodule – zur Bearbeitung der Werkzeuge. Mit den variablen Montagemodulen können Werkzeuge innerhalb der »roboBox« z. B. ein- und ausgeschrumpft, abgekühllt, gemessen, vertikal ein- und ausgespannt sowie ein- und ausgepresst werden.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/f/1/csm_roboBox_info_Messmodul_0876459bc5.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Hochpräzises Messmodul",
     "caption": "<figcaption> <h3>Hochpräzises Messmodul</h3> <p>Messmodul – in welches das Werkzeug für die Vermessung eingesetzt wird. Der Messvorgang selbst startet automatisch. </p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/7/7/csm_roboBox_info_Steuerungssoftware_43a2601b27.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Serverbasierte Steuerungssoftware",
     "caption": "<figcaption> <h3>Serverbasierte Steuerungssoftware</h3> <p>Steuerungssoftware – zur Bedienung der Automatisierungsanlage. Die Steuerungssoftware kann auf unterschiedlichen Anzeigegeräten (Monitor, Tablet oder Smartphone) angezeigt werden. </p> </figcaption>"
    }
   ],
