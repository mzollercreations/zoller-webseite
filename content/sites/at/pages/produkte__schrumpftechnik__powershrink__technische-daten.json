=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> </tr> <tr> <td> Netzkabelzuleitung </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> </tr> <tr> <td> Anschlussleistung Induktions-Schrumpfsystem 14 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> </tr> <tr> <td> Anschlussleistung Induktions-Schrumpfsystem 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 23 kVA </td> </tr> <tr> <td> Gewichte </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Kein Kühlsystem, Luftkühlung unterhalb der Induktionsspule </td> <td class=\"text-center\"> ~ 35 kg </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Werkbankausführung, zStream </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 150 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Werkbankausführung, Kühlglocken,<br/> Zusätzliches Gewicht Wasserkühler </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 143 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ~ 153 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Mit Untertisch, zStream </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 240 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Mit Untertisch, Kühlglocken </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 274 kg </td> <td class=\"text-center\"> ~ 284 kg </td> <td class=\"text-center\"> ~ 410 kg </td> </tr> </tbody> </table>",
