     {
      "type": "textmedia",
      "header": "<h1> Qualität hat ihren Wert – vor allem für unsere Kunden </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
