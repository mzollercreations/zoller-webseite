       "after": "default"
      }
     }
    ],
    [
     {
      "type": "accordion",
      "header": "",
      "items": [
       {
        "title": "»elephant 2.0« – extrem einfach zu bedienen",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>01. Auswahl <strong>Werkzeugtyp</strong> bspw. Schaftfräser &gt; Schaftfräser mit Eckradius</p> <p>02. Auswahl der gewünschten <strong>Parameter</strong></p> <p>03. Aktive <strong>Messung</strong> bspw. Wirkkontur Eckradius</p> <p>04.<strong> Messergebnisse </strong>(19 Stück, vollautomatisch gemessen und ohne Dateneingabe/Programmierung)</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/e/8/csm_software_elephant_3788f74653.webp",
            "alt": "",
            "w": 1000,
            "h": 556
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c984",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "»expert« – intelligent, einfach, genial",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>»expert« ist der Spezialist für Messungen an Präzisions­werkzeugen – basierend auf der ZOLLER-Software »pilot 4.0«. Die intelligente Software generiert aus den gewählten Parametern den optimalen Messablauf. Voll­automatisch, reproduzierbar und mit fotorealer Parameter­auswahl. Über Checkboxen können die zu messenden Parameter spielend leicht, schnell und werkzeug­spezifisch für den Messprogramm­ablauf ausgewählt werden. Einfach die zu vermessenden Parameter auswählen und bestätigen – schon startet der Messablauf.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/3/3/csm_software_expert_debaec8152.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c982",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       }
      ],
      "ftype": "accordion",
      "id": "c980",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
