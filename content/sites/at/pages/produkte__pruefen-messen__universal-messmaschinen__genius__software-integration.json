   "layout": "33-66",
   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Software­funktionen </h2>",
      "body": "<h4>Für maximale Leistung</h4>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c894",
      "bg": "",
