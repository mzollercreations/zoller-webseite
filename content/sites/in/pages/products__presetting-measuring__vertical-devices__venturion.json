   },
   "spots": [
    {
     "x": 48.934,
     "y": 18.556,
     "label": "IPC with 24\" TFT color monitor",
     "text": "<h3>IPC with 24\" TFT color monitor</h3> <h4>IPC with 24\" TFT color monitor</h4> <p>Specially designed to process the amount of data quickly and to call up the extensive programs and measurement sequences immediately. The monitor impresses with a razor-sharp display.</p>"
    },
    {
     "x": 65.542,
     "y": 41.444,
     "label": "Separate »cockpit« control unit",
     "text": "<h3>Separate »cockpit« control unit</h3> <h4>Separate »cockpit« operating unit</h4> <p>Provides space for keyboard and mouse as well as shelves for tools, printer and scanner. The monitor can be adjusted in height and tilt. The workstation can be individually adjusted in a few simple steps for comfortable working.</p>"
    },
    {
     "x": 43.606,
     "y": 47.556,
     "label": "Base body in the Z- and X-axis",
     "text": "<h3>Base body in the Z- and X-axis</h3> <h4>Base body in the Z- and X-axis</h4> <p>Manufactured from a light metal alloy specially developed for measuring devices. Designed to absorb the weight and forces of the tools. The guarantee for long-term stability and precision in reliable measuring processes.</p>"
    },
    {
     "x": 10.036,
     "y": 62.333,
     "label": "Bosch/Festo pneumatic elements",
     "text": "<h3>Bosch/Festo pneumatic elements</h3> <h4>Bosch/Festo pneumatic elements</h4> <p>For the safe operation of pneumatic functions such as the force-tensioning functions on the spindle.</p>"
    },
    {
     "x": 3.908,
     "y": 82.222,
     "label": "Sturdy equipment bed",
     "text": "<h3>Sturdy equipment bed</h3> <h4>Sturdy appliance bed</h4> <p>The base of the appliance: The computer, pneumatic elements and electronics are housed here, with sufficient space for good accessibility and optimum ventilation. This effectively prevents the computer from overheating and the system can run 24 hours a day.</p>"
    }
   ],
