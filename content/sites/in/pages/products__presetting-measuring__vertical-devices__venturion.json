  {
   "type": "hotspots",
   "header": "<h2> Strong reasons for the quality of ZOLLER </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/1/1/csm_venturion_infodots_cb4ce530c4.webp",
    "alt": "",
    "w": 1200,
