    "after": "default"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2> Automate with tool data </h2>",
   "body": "<p>Our sophisticated tool management with many interfaces and functions makes data-driven automation particularly easy. With perfectly organized tool data in the ZOLLER z.One database and the ZOLLER webTMS software, you can plan and manage the automated processes in your production on your desktop or mobile device.</p> <p>Learn more</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/c/6/csm_software_automation_en_7ad0d9045a.webp",
     "alt": "",
     "w": 1454,
