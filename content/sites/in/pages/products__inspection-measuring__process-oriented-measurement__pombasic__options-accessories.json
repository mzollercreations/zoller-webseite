      "header": "<h2> »pomBasic« &amp; »pomColorCam« </h2>",
      "table": "<table> <tbody> <tr> <td> Axes </td> <td> </td> </tr> <tr> <td> Swivel table standard </td> <td> base </td> </tr> <tr> <td> Swivel table extended </td> <td> optional </td> </tr> <tr> <td> Indexing -90°/0°/+90° </td> <td> base </td> </tr> <tr> <td> Manual clamping </td> <td> base </td> </tr> <tr> <td> Nonius angle indicator swivel table </td> <td> base </td> </tr> <tr> <td> ROD encoder Angle display swivel table </td> <td> optional </td> </tr> <tr> <td> Manual endless fine adjustment X/Y </td> <td> base </td> </tr> <tr> <td> Manual camera axis </td> <td> base </td> </tr> <tr> <td> CNC control camera axis </td> <td> base </td> </tr> <tr> <td> Electronics </td> <td> </td> </tr> <tr> <td> »pilot 4.0« 32\" TFT color monitor </td> <td> base </td> </tr> <tr> <td> Device equipment </td> <td> </td> </tr> <tr> <td> Workbench version </td> <td> base </td> </tr> <tr> <td> Machine table standing workstation </td> <td> optional </td> </tr> <tr> <td> Machine table seated workstation </td> <td> optional </td> </tr> <tr> <td> Camera/sensors </td> <td> </td> </tr> <tr> <td> »pomColorCam«, BF approx. 1,8 x 1,2 mm² to approx. 38,1 x 25,6 mm² </td> <td> base </td> </tr> <tr> <td> 8-fold LED incident light white </td> <td> base </td> </tr> <tr> <td> Additional illumination diffuser white </td> <td> optional </td> </tr> <tr> <td> »pomLightTube« white </td> <td> optional </td> </tr> <tr> <td> Single LED spot illumination white </td> <td> optional </td> </tr> </tbody> </table>",
