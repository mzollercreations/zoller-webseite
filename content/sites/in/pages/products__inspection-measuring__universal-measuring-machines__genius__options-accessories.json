   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> <br/>Accessories </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c819",
