   "columns": [
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>We have rethought shrink technology. Shrinking and unshrinking is now more efficient than ever.</h3>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c696",
      "bg": "",
