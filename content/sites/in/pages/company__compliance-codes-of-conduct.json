     {
      "type": "textmedia",
      "header": "<h1> We don't make exceptions to the rules </h1>",
      "body": "<p class=\"large-text\">Acting ethically and lawfully is part of our corporate culture. This applies to customers, business partners, shareholders, and employees. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c779",
