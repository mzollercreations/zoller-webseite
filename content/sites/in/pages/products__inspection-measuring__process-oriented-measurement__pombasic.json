  {
   "type": "product_header",
   "title": "»pomBasic«",
   "text": "<p>Process-oriented compact solutions <br/>for tool inspection</p> <p><a class=\"btn\" href=\"/in/company/contact-us\">Inquire now</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/9/csm_pomBasic_header_e15bc565eb.webp",
