    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>Kdo měří a připravuje nástroje souběžně při provozu CNC stroje, vyrábí efektivněji.</h3>",
      "images": [],
      "videos": [],
      "pos": "text",
