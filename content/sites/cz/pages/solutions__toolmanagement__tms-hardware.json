   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Inteligentní řešení pro skladování a správu </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163290",
