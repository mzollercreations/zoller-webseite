       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Chcete díky efektivnímu skladu nástrojů pracovat produktivněji a hospodárněji? Pak jsou pro vás skříně ZOLLER Smart Cabinets tou správnou volbou!</p> <p class=\"large-text\">Nabízíme vhodné skladovací řešení, ať už chcete spravovat nástroje a jejich komponenty, příslušenství nebo měřicí a kontrolní prostředky. Díky propojení se softwarem lze celý sklad zobrazit virtuálně.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c163314",
   "bg": "",
   "space": {
    "before": "none",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/1/e/csm_josua_schade_9179cf0129.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Ve společnosti ZOLLER přizpůsobujeme hardware i software potřebám uživatelů. Nabízíme tak praktická řešení z jedné ruky.</p> <p><strong>Josua Schade, produktový manažer TMS-Hardware</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/b/csm_sarah-michelle_wiacek_c4c06a6999.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Montážní tým společnosti ZOLLER v Pleidelsheimu v Německu každý den dělá maximum pro to, aby vaše Smart Cabinets měly trvale vysokou kvalitu. Je prostě skvělé být u toho!</p> <p><strong>Sarah-Michelle Wiacek, tým přípravy výroby</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/0/9/csm_michael_haas_a5847acaff.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Díky inteligentním skříním naši zákazníci společnosti ZOLLER nejen zvyšují efektivitu, ale také předcházejí chybám v průběhu výrobního procesu.</p> <p><strong>Michael Haas, obchodní zástupce ZOLLER Jih</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    }
   ],
