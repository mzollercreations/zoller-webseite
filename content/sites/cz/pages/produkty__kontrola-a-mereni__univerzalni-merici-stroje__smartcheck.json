  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Univerzální měřicí a kontrolní technika<br/>pro procesně orientovanou kontrolu nástrojů</p> <p><a class=\"btn\" href=\"/cz/spolecnost/kontakt\">Požádat o nabídku</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
   "id": "c1606",
   "bg": "",
