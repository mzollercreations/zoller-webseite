  {
   "type": "hotspots",
   "header": "<h2> Pádné důvody pro kvalitu značky ZOLLER </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/1/1/csm_venturion_infodots_cb4ce530c4.webp",
