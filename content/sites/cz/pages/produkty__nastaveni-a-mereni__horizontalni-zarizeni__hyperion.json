  {
   "type": "product_header",
   "title": "»hyperion«",
   "text": "<p>Vyšší produktivita díky přesně nastaveným soustružnickým nástrojům</p> <p><a class=\"btn\" href=\"/cz/spolecnost/kontakt\">Zeptejte se nyní</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/1/csm_hyperion_header_0b7c1cdce7.webp",
    "alt": "",
    "w": 1080,
    "h": 930
