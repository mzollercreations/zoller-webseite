   "type": "hotspots",
   "header": "<h2> Spolehlivost a nejvyšší přesnost </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/7/6/csm_ts_pin_modul_03_be3bbbf942.webp",
