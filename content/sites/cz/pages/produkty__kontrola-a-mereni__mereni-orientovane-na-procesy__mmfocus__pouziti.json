  {
   "type": "textmedia",
   "header": "<h1> Kontrola řezných hran pomocí »mµFocus« – řešení s přesností 0,1 µm </h1>",
   "body": "<p>»mµFocus« bezkontaktně analyzuje úpravu řezných hran a drsnost povrchu. Jeho rozlišení při měření drsnosti činí 0,1 µm.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/b/4/csm_muefocus_infodots_01_823d7f4cd6.webp",
     "alt": "",
     "w": 1340,
     "h": 840
    }
   ],
   "videos": [],
