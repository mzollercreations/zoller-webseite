     {
      "type": "textmedia",
      "header": "<h1> Často kladené otázky </h1>",
      "body": "<p>Často kladené otázky</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c844",
      "bg": "",
