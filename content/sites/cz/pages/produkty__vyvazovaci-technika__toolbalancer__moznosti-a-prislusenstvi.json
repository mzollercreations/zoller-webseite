    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Dva modely, bohatá výbava a praktické doplňky: Vyberte si mezi dvěma různými délkami nástrojů a příslušenstvím pro optimální každodenní použití. Pro zcela individuální pracovní postupy a podmínky ve vaší výrobě.<br/><br/>Vyberte si snadno a přehledně, nebo se na nás obraťte: Rádi vám poradíme s výběrem modelu a s inovativní škálou doplňků.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1109",
      "bg": "",
