  {
   "type": "hotspots",
   "header": "<h2> Zaznamenávání a propojení vašich dat </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/a/1/csm_vernetzung_infodots_11_bae0da944d.webp",
    "alt": "",
