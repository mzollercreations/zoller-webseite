   "columns": [
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>Přepracovali jsme technologii tepelného upínání. Ohřev a chlazení nyní probíhá efektivněji než kdykoli předtím. </h3>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c696",
      "bg": "",
