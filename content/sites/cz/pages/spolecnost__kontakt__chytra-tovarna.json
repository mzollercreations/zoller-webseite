    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">V ZOLLER Smart Factory si můžete vyzkoušet systém ZOLLER se sedmi řešeními v praxi. Získáte přehled o tom, jak můžete díky dokonalé souhře hardwaru, softwaru, rozhraní a automatizace využít další potenciál pro zvýšení efektivity ve vaší výrobě.</p> <p class=\"large-text\">ZOLLER Smart Factory působivě ukazuje, že cesta k vyšší produktivitě může vést po malých krocích. Díky tomu je další rozvoj vlastní výroby lépe plánovatelný a realizovatelný. </p> <p class=\"large-text\">Domluvte si ještě dnes termín návštěvy v ZOLLER Smart Factory v Pleidelsheimu. </p> <p class=\"large-text\"><a class=\"btn\" href=\"/cz/spolecnost/kontakt\">Domluvte si termín</a></p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c2843",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
