          "id": "c1544",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Ruční čtecí a zapisovací stanice RFID »mslz«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Pro ruční zápis/čtení kódového nosiče na upínacím zařízení nástroje pomocí ruční čtečky.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/a/f/csm_option_rfid_34dfe1d75c.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c1542",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "UPS",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Záložný zdroj napájení (UPS) zajišťuje, že v případě výpadku elektrické sítě dojde k řádnému vypnutí počítače, aby nedošlo ke ztrátě dat. K dispozici jsou napájecí napětí 230 V~ (Evropa) nebo 120 V~ (USA).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/2/csm_option_usv_4c4cb5d571.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
