   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> Funkčnost </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c4101",
