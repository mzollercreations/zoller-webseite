     {
      "type": "textmedia",
      "header": "<h2> Z pravidla neděláme výjimky </h2>",
      "body": "<p class=\"large-text\">Etické a zákonné jednání je součástí naší firemní kultury. To platí pro zákazníky, obchodní partnery, akcionáře i zaměstnance. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c26285",
