  {
   "type": "product_header",
   "title": "Řešení pro upínání nástrojů",
   "text": "<p>Nástrojový upínací držák jako ideální rozhraní<br/>pro Vaši digitální výrobu</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Koupit nyní</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/d/c/csm_header_tooling_79126defc9.webp",
    "alt": "",
    "w": 1428,
    "h": 896
   },
   "ftype": "zoller_product_header",
   "id": "c1416",
   "bg": "",
