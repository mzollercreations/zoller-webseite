   "images": [
    {
     "src": "/fileadmin/_processed_/b/8/csm_bestueckung_6fach_9ae3d33bd9.webp",
     "alt": "",
     "w": 633,
     "h": 398,
     "title": "Fitting D 745 - 6-fold pitch",
     "caption": "<figcaption> <h3>Fitting D 745 - 6-fold pitch</h3> <p>For different tool holders. By turning the turret table, the user always has the correct tool holder in the measuring range.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/0/9/csm_bestueckung_8fach_adda36b1c6.webp",
     "alt": "",
     "w": 633,
     "h": 398,
     "title": "Fitting D 745 - 8-fold pitch",
     "caption": "<figcaption> <h3>Fitting D 745 - 8-fold pitch</h3> <p>For four universal holders HGH-UZ, two basic holders GA-PP and two basic holders GA. The number of adapters and attachment holders that can be used is virtually unlimited.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/5/7/csm_bestueckung_12fach_ee5625722e.webp",
     "alt": "",
     "w": 633,
     "h": 398,
     "title": "Fitting D 900 - 12-fold pitch",
     "caption": "<figcaption> <h3>Fitting D 900 - 12-fold pitch</h3> <p>Universal holder HGH-UZ for rotating and stationary<br/> tools - special tool holders for Göltenbodt<br/> tool holders for Göltenbodt, Schütte, Traub, Index and others can also be fitted.</p> </figcaption>"
    }
   ],
