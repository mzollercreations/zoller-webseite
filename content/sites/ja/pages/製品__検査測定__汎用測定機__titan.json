  {
   "type": "product_header",
   "title": "»titan«",
   "text": "<p>工具メーカーおよび研削業者向けの汎用ハイエンド<br/>測定機</p> <p><a class=\"btn\" href=\"/ja/%E4%BC%81%E6%A5%AD/%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B\">今すぐお問い合わせください</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/f/e/csm_titan_header_93e4500a66.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
   "id": "c1589",
   "bg": "",
