     {
      "type": "textmedia",
      "header": "",
      "body": "<h2>ゾラーのダイバーシティ：本社（<br/>プライデルスハイム）に集う24カ国出身のチーム</h2>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3184",
