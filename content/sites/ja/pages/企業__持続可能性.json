  {
   "type": "textmedia",
   "header": "<h2> 当社の<br/>サステナビリティ戦略の重点分野 </h2>",
   "body": "",
   "images": [
    {
     "src": "/fileadmin/_processed_/f/b/csm_Teaser_Helene_Zoller_Garten_84c13c8545.webp",
     "alt": "",
