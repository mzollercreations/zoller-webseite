     {
      "type": "textmedia",
      "header": "<h1> ソフトウェア </h1>",
      "body": "<p class=\"large-text\">自動化</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c2775",
