     {
      "type": "textmedia",
      "header": "<h1> よくある質問 </h1>",
      "body": "<p>よくある質問</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1199",
