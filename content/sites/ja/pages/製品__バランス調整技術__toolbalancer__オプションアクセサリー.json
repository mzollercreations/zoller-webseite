       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">2つのモデル、充実した標準装備、実用的なオプション：日々の作業に最適な2種類のツール長とアクセサリーからお選びいただけます。お客様の製造現場における独自の作業フローや環境に合わせて。分かりやすく簡単に<br/><br/>選択いただくか、ぜひ弊社までお問い合わせください。モデルの選定や、革新的な多彩なオプションについて、喜んでご相談に応じます。</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1109",
