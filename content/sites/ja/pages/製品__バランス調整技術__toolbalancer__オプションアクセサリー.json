   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> すべてのオプション<br/>の概要 </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
