   }
  },
  {
   "type": "textmedia",
   "header": "<h2> トルクアダプター（その他は要相談） </h2>",
   "body": "<figure><table><tbody><tr><td>バランスアダプター SK 30/40/50</td></tr><tr><td>バランスアダプター HSK 32/40/50/63/80/100 (A/C/E-B/D/F)</td></tr><tr><td>バランスアダプター PSC C 32/40/50/63/80</td></tr></tbody></table></figure>",
