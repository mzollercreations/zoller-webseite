  {
   "type": "product_header",
   "title": "»micBox«",
   "text": "<p>高効率なインサート交換装置</p> <p><a class=\"btn\" href=\"/ja/%E4%BC%81%E6%A5%AD/%E3%81%8A%E5%95%8F%E3%81%84%E5%90%88%E3%82%8F%E3%81%9B\">今すぐお問い合わせください</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/4/csm_micbox_header_852f2d46f4.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
