   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> 機能性 </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c232727",
