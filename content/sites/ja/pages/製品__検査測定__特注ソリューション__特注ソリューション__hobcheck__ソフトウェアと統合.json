    [
     {
      "type": "accordion",
      "header": "",
      "items": [
       {
        "title": "360°の真円度検査",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>円形面（工具シャンクなど）の真円度を自動的に測定し、輪郭全体の形状をグラフィカルに評価するため。</p>",
          "images": [
           {
