   "images": [
    {
     "src": "/fileadmin/_processed_/d/b/csm_teaser_balancing_small_e3b1b4fcf5.webp",
     "alt": "",
     "w": 955,
     "h": 502,
     "title": "ツールバランサー：そのメリット",
     "href": "/ja/%E3%82%BD%E3%83%AA%E3%83%A5%E3%83%BC%E3%82%B7%E3%83%A7%E3%83%B3/%E3%83%90%E3%83%A9%E3%83%B3%E3%82%B9%E8%AA%BF%E6%95%B4%E6%8A%80%E8%A1%93",
     "caption": "<figcaption> <h3>ツールバランサー：そのメリット</h3> <p>バランス調整の重要性は過小評価されがちです。しかし、バランス調整を行うことで、コスト増の原因となる工具の摩耗を軽減し、機械のスピンドルへの負担を軽減できるため、経済性の向上につながります。 </p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/f/6/csm_Teaser-2Colume-1zu1-Expert_222328b94b.webp",
     "alt": "Christoph Zoller",
     "w": 955,
