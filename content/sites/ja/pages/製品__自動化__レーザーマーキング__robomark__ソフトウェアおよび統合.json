   "columns": [
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h4>ステータス表示とパレット<br/>管理</h4>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
