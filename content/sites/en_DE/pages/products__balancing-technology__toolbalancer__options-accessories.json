  {
   "type": "textmedia",
   "header": "<h2> Accessories </h2>",
   "body": "<figure><table><tbody><tr><td>Tool identification by hand scanner with holder</td></tr><tr><td>Precision scales (optionally with DAkkS certification)/tool scales</td></tr><tr><td>Stand shelf for scales and balancing screw set</td></tr><tr><td>Laser printer/label printer</td></tr><tr><td>Trays for label printers, laser printers, tools</td></tr><tr><td>Certified calibration rotor</td></tr><tr><td>Calibration magnets</td></tr><tr><td>Balancing kneader</td></tr><tr><td>Balancing screw set/balancing rings</td></tr><tr><td>UPS system 230 V/750 VA</td></tr><tr><td>Floor fixing kit</td></tr></tbody></table></figure>",
