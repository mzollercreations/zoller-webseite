   "type": "textmedia",
   "header": "<h2> Device equipment </h2>",
   "body": "<figure><table><tbody><tr><td>Integrated operating unit (monitor holder) with 17-inch touch monitor and ZOLLER operating software</td></tr><tr><td>Separate »cockpit« operating unit, with 17-inch touch monitor and ZOLLER operating software, incl. keyboard, mouse and shelves for printers and other accessories</td></tr><tr><td>»twinPanel« safety cover for maximum safety during balancing</td></tr><tr><td>Control cabinet for careful storage of all electronic components</td></tr><tr><td>Membrane keypad for operating the spindle and hood lock</td></tr><tr><td>Emergency stop circuit</td></tr><tr><td>Storage compartment for balancing adapter</td></tr></tbody></table></figure>",
   "images": [],
   "videos": [],
