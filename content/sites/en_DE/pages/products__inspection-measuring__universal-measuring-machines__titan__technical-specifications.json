  {
   "type": "table",
   "header": "<h2> Application </h2>",
   "table": "<table> <tbody> <tr> <td> 2D parameters incident light </td> <td> </td> </tr> <tr> <td> Diameter standard 2-100 mm </td> <td> base </td> </tr> <tr> <td> Microtools 0.1-10 mm </td> <td> optional </td> </tr> <tr> <td> 3D parameters incident light </td> <td> </td> </tr> <tr> <td> Partial </td> <td> base </td> </tr> <tr> <td> Area </td> <td> base </td> </tr> <tr> <td> Measuring tasks </td> <td> </td> </tr> <tr> <td> Cutting edge preparation </td> <td> optional </td> </tr> <tr> <td> Roughness </td> <td> optional </td> </tr> <tr> <td> Threading tools </td> <td> optional </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c2374",
   "bg": "",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "table",
   "header": "<h2> Sensor configuration </h2>",
   "table": "<table> <tbody> <tr> <td> Optics-transmitted light </td> <td> </td> </tr> <tr> <td> Transmitted light camera HR70, BF approx. 4.0 x 3.6 mm2 </td> <td> basic </td> </tr> <tr> <td> Transmitted light camera 5 Mpx, BF approx. 5.5 x 5.0 mm2 </td> <td> optional </td> </tr> <tr> <td> Transmitted light camera WF, BF approx. 15.5 x 14.1 mm2 </td> <td> optional </td> </tr> <tr> <td> Optics incident light </td> <td> </td> </tr> <tr> <td> Reflected light camera HR70 Standard, BF approx. 1.1 x 1.0 mm2 </td> <td> Basic </td> </tr> <tr> <td> Incident light camera HR70 Micro, BF approx. 0.4 x 0.4 mm2 </td> <td> optional </td> </tr> <tr> <td> »zep sensor«(cutting edge preparation) </td> <td> optional </td> </tr> <tr> <td> »zep-R sensor«(cutting edge preparation/roughness) </td> <td> optional </td> </tr> <tr> <td> »Z3dCam sensor«(digitization) </td> <td> optional </td> </tr> <tr> <td> Tactile </td> <td> </td> </tr> <tr> <td> Scanning probe </td> <td> optional </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c2373",
   "bg": "",
   "space": {
    "before": "extra-small",
    "after": "extra-small"
   }
  },
  {
   "type": "table",
   "header": "<h2> Measuring machine configuration </h2>",
   "table": "<table> <tbody> <tr> <td> Spindle </td> <td> </td> </tr> <tr> <td> High-precision spindle »tcs </td> <td> basic« </td> </tr> <tr> <td> High-precision spindle »ahd </td> <td> optional« </td> </tr> <tr> <td> Hollow encoder </td> <td> base </td> </tr> <tr> <td> Linear drive </td> <td> </td> </tr> <tr> <td> Positive locking ball screw </td> <td> base </td> </tr> <tr> <td> X-, Y-axis in cross table design </td> <td> base </td> </tr> <tr> <td> Optics drive </td> <td> </td> </tr> <tr> <td> Swivel axis incident light </td> <td> base </td> </tr> <tr> <td> Swivel axis incident light &amp; transmitted light </td> <td> optional </td> </tr> <tr> <td> Vibration damping </td> <td> </td> </tr> <tr> <td> Integrated, active with level control </td> <td> base </td> </tr> <tr> <td> Leveling element on machine feet </td> <td> base </td> </tr> <tr> <td> Material </td> <td> </td> </tr> <tr> <td> Hard stone </td> <td> base </td> </tr> </tbody> </table>",
