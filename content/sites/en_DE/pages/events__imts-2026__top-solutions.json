   "tiles": [
    {
     "img": {
      "src": "/fileadmin/_processed_/2/e/csm_teaser_presetting_1bc168b412.webp",
      "alt": ""
     },
     "text": "<h2>Presetting &amp; Measuring</h2> <p>Reduce set-up times <br/>by 40 % and more.</p> <p><a class=\"btn\" href=\"/en_DE/solutions/presetting-measuring\" rel=\"noopener\" target=\"_blank\">Learn more</a></p>",
     "full": false
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/1/0/csm_teaser_toolmanagement_7103509fb4.webp",
      "alt": ""
     },
     "text": "<h2>Tool Management</h2> <p>Tool storage, software, error-free <br/>data transfer: make more of <br/>your tools and tool data.</p> <p>Learn more</p>",
     "full": false
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/c/7/csm_teaser_inspection_8db5d700b8.webp",
      "alt": ""
     },
     "text": "<h2>Inspection &amp; Measuring</h2> <p>Document quality and <br/>create digital twins.</p> <p><a class=\"btn\" href=\"/en_DE/solutions/inspection-measuring\" rel=\"noopener\" target=\"_blank\">Learn more</a></p>",
     "full": false
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/3/csm_teaser_shrinking_f763ceca8f.webp",
      "alt": ""
     },
     "text": "<h2>Tool Heat Shrink Technology</h2> <p>Shrinking and unshrinking of <br/>tools in record time.</p> <p><a class=\"btn\" href=\"/en_DE/solutions/shrink-technology\" rel=\"noopener\" target=\"_blank\">Learn more</a></p>",
     "full": false
    },
    {
     "img": {
      "src": "/fileadmin/01_Pages/Solutions/Automation/zoller_automation_komp.mp4",
      "alt": ""
     },
     "text": "<h2>Automation</h2> <p>From setting, measuring and inspecting tools to the complete <br/>automation of your tool processes - ZOLLER has the solution.</p> <p><a class=\"btn\" href=\"/en_DE/solutions/automation\" rel=\"noopener\" target=\"_blank\">Learn more</a></p>",
     "full": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/0/b/csm_teaser_tooling_b7ac4272bd.webp",
      "alt": ""
     },
     "text": "<h2>Tooling Solutions</h2> <p>Tool holder with »idChip« as the perfect <br/>interface for your digital production.</p> <p><a class=\"btn\" href=\"/en_DE/solutions/tooling-solutions\" rel=\"noopener\" target=\"_blank\">Learn more</a></p>",
     "full": false
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/8/csm_teaser_balancing_a6279efe6e.webp",
      "alt": ""
     },
     "text": "<h2>Tool Balancing Technology</h2> <p>Protect spindles, ensure quality: <br/>with the best balancing devices on the market.</p> <p><a class=\"btn\" href=\"/en_DE/solutions/balancing-technology\" rel=\"noopener\" target=\"_blank\">Learn more</a></p>",
     "full": false
    }
   ],
