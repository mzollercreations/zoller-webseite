    [
     {
      "type": "textmedia",
      "header": "<h2> One precise base, three controls. </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c3493",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">The ZOLLER »smile« entry-level models are equipped with high-quality brand components and are available with the three measuring device software versions \"pilotBasic\", \"pilotStarter\" and \"pilot 2 mT\". You get precise results straight away - without the need for training. Ideal for all standard tools and designed for the tool requirements of medium and small batch sizes. Robust, space-saving and flexible placement directly next to the CNC machine, in the workshop or in production islands.</p> <p class=\"large-text\">In short - the »smileCompact« is the perfect introduction to the world of ZOLLER.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3494",
      "bg": "",
