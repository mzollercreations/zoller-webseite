    "after": "default"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2> Figuras tridimensionais de alta precisão </h2>",
   "body": "<p class=\"large-text\">Com base em várias imagens individuais, »o mµFocus« calcula representações 3D altamente precisas da lâminas da ferramenta. A quantidade de imagens permite definir o nível de detalhe. O resultado de medição pode ser exibido topograficamente, em tons de cinzento, como curvas de medição ou em tabelas, de acordo com a norma DIN. A visão mais abrangente da lâmina da ferramenta.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/f/1/csm_muefocus_c01_a66e9ca4dd.webp",
     "alt": "",
     "w": 1454,
     "h": 1454
    }
   ],
   "videos": [],
   "pos": "right",
   "cols": 1,
   "valign": "center",
   "ftype": "textmedia",
   "id": "c1819",
