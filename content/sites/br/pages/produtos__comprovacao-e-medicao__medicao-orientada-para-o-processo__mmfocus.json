   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2> Leva-o às estruturas mais requintadas </h2>",
   "body": "<p class=\"large-text\">O ZOLLER »mμFocus« aborda as microestruturas de forma sistemática. Com processos claros e ferramentas de apoio, obtém informações detalhadas sobre o corte e as superfícies das ferramentas. Deteta rapidamente o desgaste, cria um modelo 3D com apenas um clique e mede facilmente a preparação das arestas de corte e a rugosidade.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/9/d/csm_muefocus_c02_ad2464f4fa.webp",
     "alt": "",
     "w": 1454,
     "h": 1454
    }
   ],
   "videos": [],
   "pos": "right",
