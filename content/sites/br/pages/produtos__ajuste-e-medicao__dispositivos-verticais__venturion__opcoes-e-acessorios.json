           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Dispositivo giratório CNC",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Para medições sem distorções de ferramentas com furos, como ferramentas de rosca e fresas helicoidais.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/8/csm_option_cnc_schwenkeinrichtung_0fc04921b8.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3321",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Sistema automático »de paragem longitudinal »asza«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Dispositivo de reajuste linear controlado por CNC para ajustar ferramentas em comprimento através de uma haste de batente. Alternativamente disponível como »asza-rot«, com o qual o comprimento da ferramenta pode ser ajustado opcionalmente através da rotação automática do parafuso de ajuste de comprimento (não se aplica a forros de retração).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/1/csm_option_asza_32f127ae86.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3319",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Eixo Y na torre",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Graças ao eixo Y adicional, o suporte da ótica pode ser posicionado até ± 50 mm a partir do centro do fuso, controlado por CNC na direção Y. Em combinação com a câmera de medição do centro de rotação, as ferramentas de giro e rotativas podem ser medidas de forma eficiente e com alta precisão e ajustadas na altura do centro|altura da ponta.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/3/6/csm_option_yachse_7a1e458de7.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3317",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Versão »com cabeçote móvel phoenix«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>O cabeçote móvel pode ser facilmente rebaixado e mantém ferramentas longas e finas exatamente na posição, com uma força de pressão definida. Além das ferramentas, também é possível realizar a medição de componentes entre pontas.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/5/csm_option_reitstock_phoenix_249d45464d.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
