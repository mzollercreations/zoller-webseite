          }
         }
        ]
       },
       {
        "title": "sonda",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Para medição tátil de lâminas da ferramenta.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/5/4/csm_option_messtaster_5313cb85ba.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
