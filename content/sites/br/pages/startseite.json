  {
   "type": "textmedia",
   "header": "<h2> Tecnologia premium para todos os processos </h2>",
   "body": "<p class=\"extra-large-text\"><br/>As soluções da ZOLLER garantem que você possa produzir mais peças, com maior qualidade e menor custo.</p> <p class=\"extra-large-text\">Na ZOLLER, premium é uma promessa, não um privilégio.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/5/2/csm_az_cz_30f31cdd7e.webp",
     "alt": "",
     "w": 1155,
     "h": 1034
    }
   ],
   "videos": [],
   "pos": "right",
   "cols": 1,
   "valign": "center",
