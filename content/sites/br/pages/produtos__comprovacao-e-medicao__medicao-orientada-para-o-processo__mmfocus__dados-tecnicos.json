      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Sensor »zep-R« para medição da geometria de corte 3D e da rugosidade da superfície </h2>",
      "table": "<table> <tbody> <tr> <td> Eixo Z </td> <td> 300 mm </td> </tr> <tr> <td> AA </td> <td> 20 mm </td> </tr> <tr> <td> Princípio de medição </td> <td> Microscópio confocal </td> </tr> <tr> <td> Menor raio mensurável </td> <td> 3 μm (valores para objetiva de 20 aumentos; valores para objetiva de 50 aumentos: 1,4 μm) </td> </tr> <tr> <td> Abertura numérica </td> <td> 0,42 mm </td> </tr> </tbody> </table>",
