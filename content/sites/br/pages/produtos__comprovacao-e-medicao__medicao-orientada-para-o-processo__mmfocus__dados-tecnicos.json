     {
      "type": "table",
      "header": "<h2> Sensor »zep« para medição da geometria do corte </h2>",
      "table": "<table> <tbody> <tr> <td> Eixo Z </td> <td> 300 mm </td> </tr> <tr> <td> AA (descreve a menor distância entre a lente e o objeto de medição) </td> <td> Projeção de faixa3 </td> </tr> <tr> <td> Princípio de medição </td> <td> 0 mm </td> </tr> <tr> <td> Menor raio mensurável </td> <td> 3 μm </td> </tr> <tr> <td> Abertura numérica </td> <td> – </td> </tr> </tbody> </table>",
      "ftype": "table",
