   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Aspereza do perfil: escolha de parâmetros mensuráveis de acordo com as normas ISO 4287 e ISO 13565 </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> média aritmética ao longo de todo o comprimento de medição </td> <td> </td> </tr> <tr> <td> Rq </td> <td> média quadrática </td> <td> </td> </tr> <tr> <td> Rt </td> <td> altura total do perfil de rugosidade </td> <td> </td> </tr> <tr> <td> Rmax </td> <td> altura máxima do perfil de rugosidade dentro de um único intervalo de medição </td> <td> </td> </tr> <tr> <td> Rz </td> <td> altura média do perfil de rugosidade </td> <td> </td> </tr> <tr> <td> Rp </td> <td> altura do pico maior no perfil de rugosidade </td> <td> </td> </tr> <tr> <td> Rv </td> <td> profundidade do vale maior no perfil de rugosidade </td> <td> </td> </tr> <tr> <td> Rk </td> <td> profundidade do núcleo, altura da área central </td> <td> </td> </tr> <tr> <td> Rpk </td> <td> altura reduzida do centro </td> <td> altura da ponta </td> </tr> <tr> <td> Rvk </td> <td> profundidade reduzida do sulco </td> <td> </td> </tr> <tr> <td> Mr1 </td> <td> proporção de material acima da área central (curva de Abbott) </td> <td> </td> </tr> <tr> <td> Mr2 </td> <td> proporção de material que suporta carga (curva de Abbott) </td> <td> </td> </tr> <tr> <td> Rsm </td> <td> largura média da ranhura </td> <td> </td> </tr> <tr> <td> RPc </td> <td> valor de contagem de picos </td> <td> </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Aspereza da superfície: escolha de parâmetros mensuráveis de acordo com as normas ISO 25178-2 e ISO 16610 </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> altura aritmética média da superfície limitada pela escala </td> <td> </td> </tr> <tr> <td> Sq </td> <td> altura quadrática média da superfície limitada pela escala </td> <td> </td> </tr> <tr> <td> Sp </td> <td> altura máxima do centro da superfície limitada pela escala </td> <td> </td> </tr> <tr> <td> Sv </td> <td> altura máxima do vale da superfície limitada pela escala </td> <td> </td> </tr> <tr> <td> Sz </td> <td> altura máxima da superfície limitada pela escala </td> <td> </td> </tr> <tr> <td> S10z </td> <td> Altura de dez pontos da superfície </td> <td> </td> </tr> <tr> <td> Ssk </td> <td> Inclinação da superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Sku </td> <td> Kurtose da superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Sdq </td> <td> Gradiente quadrático médio da superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Sdr </td> <td> Relação de transição desenvolvida de uma superfície limitada por escala </td> <td> </td> </tr> <tr> <td> FLT </td> <td> nível </td> <td> </td> </tr> <tr> <td> Sk </td> <td> altura do núcleo </td> <td> </td> </tr> <tr> <td> Spk </td> <td> altura reduzida do centro </td> <td> altura da ponta </td> </tr> <tr> <td> Svk </td> <td> altura reduzida do vale </td> <td> </td> </tr> <tr> <td> Smr1 </td> <td> proporção de material dos picos </td> <td> </td> </tr> <tr> <td> Smr2 </td> <td> proporção de material dos vales </td> <td> </td> </tr> <tr> <td> Vmc </td> <td> volume do material do núcleo de uma superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Vmp </td> <td> volume do material do pico de uma superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Vvc </td> <td> volume vazio do núcleo de uma superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Vvv </td> <td> volume vazio dos vales de uma superfície limitada por escala </td> <td> </td> </tr> <tr> <td> Sxp </td> <td> valor extremo da altura do centro </td> <td> altura da ponta </td> </tr> <tr> <td> Str </td> <td> proporção da textura da superfície </td> <td> </td> </tr> </tbody> </table>",
