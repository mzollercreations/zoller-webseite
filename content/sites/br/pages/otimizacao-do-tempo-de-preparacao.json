 "blocks": [
  {
   "type": "hero",
   "slides": [
    {
     "img": "/fileadmin/_processed_/2/3/csm_ruesten_header_8622b0d406.webp",
     "video": null,
     "title": "Porquê otimizar o tempo de preparação?",
     "kicker": "",
     "text": "",
