  {
   "type": "product_header",
   "title": "»mµFocus«",
   "text": "<p>Lo strumento di misura <br/>per l'onatura e la rugosità</p> <p><a class=\"btn\" href=\"/it/azienda/contatto\">Richiedi ora</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/8/csm_myFocus_header_de2cb108cf.webp",
