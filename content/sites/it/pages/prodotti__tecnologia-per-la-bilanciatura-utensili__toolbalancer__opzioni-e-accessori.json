  {
   "type": "textmedia",
   "header": "<h2> Accessori </h2>",
   "body": "<figure><table><tbody><tr><td>Identificazione degli utensili tramite scanner manuale con supporto</td></tr><tr><td>Bilancia di precisione (opzionale con certificazione DAkkS)/bilancia per utensili</td></tr><tr><td>Piede di appoggio per bilance e set di viti di bilanciamento</td></tr><tr><td>Stampante laser/stampante per etichette</td></tr><tr><td>Supporti per stampante per etichette, stampante laser, utensili</td></tr><tr><td>Rotore per la calibrazione certificato</td></tr><tr><td>Magneti di calibrazione</td></tr><tr><td>Pesi di bilanciatura</td></tr><tr><td>Set di viti di bilanciamento/anelli di bilanciamento</td></tr><tr><td>Impianto UPS 230 V/750 VA</td></tr><tr><td>Kit di fissaggio</td></tr></tbody></table></figure>",
