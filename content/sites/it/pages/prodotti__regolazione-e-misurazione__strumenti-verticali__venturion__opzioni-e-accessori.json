          }
         }
        ]
       },
       {
        "title": "Tastatore",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Per la misurazione a contatto dei taglienti degli utensili.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/5/4/csm_option_messtaster_5313cb85ba.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
