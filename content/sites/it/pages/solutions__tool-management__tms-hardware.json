   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Soluzioni intelligenti per il magazzino e la gestione </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
