       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Desideri lavorare in modo più produttivo ed economico con un magazzino utensili efficace? Allora gli Smart Cabinet ZOLLER sono esattamente quello che fa per te!</p> <p class=\"large-text\">Offriamo la soluzione per lo stoccaggio più adatta alle tue esigenze, sia per gestire utensili e relativi componenti, accessori sia per strumenti di misura e controllo. Grazie al collegamento software, è possibile effettuare la rappresentazione virtuale dell'intero magazzino.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
