  {
   "type": "product_header",
   "title": "Soluzioni d'utensileria",
   "text": "<p>Portautensili come interfaccia perfetta<br/>per la produzione digitale</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Acquista ora</a></p>",
   "img": {
