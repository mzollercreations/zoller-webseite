          "id": "c1544",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Stazione di lettura/scrittura RFID manuale »mslz«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Per la scrittura/lettura manuale del supporto codice sull'alloggiamento dell'utensile tramite un lettore manuale.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/a/f/csm_option_rfid_34dfe1d75c.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c1542",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Impianto UPS",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>L'impianto UPS per l'alimentazione elettrica ininterrotta garantisce che, in caso di anomalie alla rete elettrica, il computer venga arrestato correttamente per evitare la perdita di dati. Sono disponibili tensioni di rete di 230 V~ (Europa) o 120 V~ (USA).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/2/csm_option_usv_4c4cb5d571.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
