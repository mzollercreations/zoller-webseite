    [
     {
      "type": "textmedia",
      "header": "<h1> Domande frequenti </h1>",
      "body": "<p>FAQ</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
