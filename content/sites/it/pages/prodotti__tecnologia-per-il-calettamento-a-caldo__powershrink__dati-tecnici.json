   "type": "table",
   "header": "",
   "table": "<table> <tbody> <tr> <td> </td> <td class=\"text-center\"> »powerShrink 200« </td> <td class=\"text-center\"> »powerShrink 300« </td> <td class=\"text-center\"> »powerShrink 400« </td> <td class=\"text-center\"> »powerShrink 600« </td> </tr> <tr> <td> Lunghezza utensile termoretraibile </td> <td class=\"text-center\"> 400 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> </tr> <tr> <td> Diametro interno massimo della bobina ad induzione con sistema di schermatura »varOct« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 45,8 mm </td> <td class=\"text-center\"> 45,8 mm </td> <td class=\"text-center\"> 45,8 mm </td> </tr> <tr> <td> Diametro interno massimo della bobina ad induzione con dischi di schermatura »varOct« </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> </tr> <tr> <td> Diametri termorestringibili con bobina ad induzione da 14 kVA </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> </tr> <tr> <td> Diametri termorestringibili con bobina ad induzione da 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 16–50 mm </td> </tr> <tr> <td> Valori di allacciamento </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Valori di allacciamento sistemi pneumatici </td> <td class=\"text-center\"> 6–8 bar </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 6–8 bar </td> </tr> <tr> <td> Valori di allacciamento elettrici </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> </tr> <tr> <td> Cavo di alimentazione </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> </tr> <tr> <td> Potenza assorbita sistema di termorestringimento a induzione 14 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> </tr> <tr> <td> Potenza allacciata del sistema di termoretrazione a induzione 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 23 kVA </td> </tr> <tr> <td> Pesi </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Senza sistema di raffreddamento, raffreddamento ad aria sotto la bobina ad induzione </td> <td class=\"text-center\"> ~ 35 kg </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Versione da banco, »zStream« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 150 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Versione da banco, campane di raffreddamento,<br/> peso ulteriormente aggiunto del radiatore ad acqua </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 143 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ~ 153 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Con tavolo di appoggio, »zStream« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 240 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Con tavolo di appoggio, campane di raffreddamento </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 274 kg </td> <td class=\"text-center\"> ~ 284 kg </td> <td class=\"text-center\"> ~ 410 kg </td> </tr> </tbody> </table>",
