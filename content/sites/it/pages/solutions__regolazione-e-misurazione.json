    "after": "small"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2 class=\"headline-decor\"> Migliore produttività </h2>",
   "body": "<p class=\"large-text\">I tempi di fermo macchina sono costosi e inutili. Se gli utensili vengono presettati sulla macchina, è possibile avviare prima l'ordine successivo. Massimizza ora la produttività con un dispositivo di presetting e macchina di misurazione ZOLLER.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/e/5/csm_presetting_02_f4a2e05503.webp",
     "alt": "",
     "w": 1220,
     "h": 1250
    }
   ],
   "videos": [],
   "pos": "right",
   "cols": 1,
   "valign": "center",
   "ftype": "textmedia",
