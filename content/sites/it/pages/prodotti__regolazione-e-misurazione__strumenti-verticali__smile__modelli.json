      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">I modelli base ZOLLER »smile« sono equipaggiati con componenti di alta qualità e sono disponibili con le tre varianti di software per macchine di misura »pilotBasic«, »pilotStarter« e »pilot 2 mT«. Ottieni risultati precisi fin da subito. Ideali per tutti gli utensili standard e progettati per le esigenze di utensili speciali. Robusti, poco ingombranti e posizionabili in modo flessibile direttamente accanto alla macchina CNC, in officina o nelle isole di produzione. </p> <p class=\"large-text\">In breve, »smileCompact« è il modo perfetto per entrare nel mondo ZOLLER. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3494",
      "bg": "",
