   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> FAQ </h1>",
      "body": "<p>Foire aux questions</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
