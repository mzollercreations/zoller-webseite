  {
   "type": "hotspots",
   "header": "<h2> De solides arguments en faveur de la qualité ZOLLER </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/7/e/csm_smile_infodots_fc64de3107.webp",
    "alt": "",
