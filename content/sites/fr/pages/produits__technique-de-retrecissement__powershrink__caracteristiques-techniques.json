   "table": "<table> <tbody> <tr> <td> </td> <td class=\"text-center\"> »powerShrink 200« </td> <td class=\"text-center\"> »powerShrink 300« </td> <td class=\"text-center\"> »powerShrink 400« </td> <td class=\"text-center\"> »powerShrink 600« </td> </tr> <tr> <td> Longueur d'outil rétractable </td> <td class=\"text-center\"> 400 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> </tr> <tr> <td> Diamètre intérieur max. de la bobine d’induction avec système de blindage »varOct« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 45,8 mm </td> <td class=\"text-center\"> 45,8 mm </td> <td class=\"text-center\"> 45,8 mm </td> </tr> <tr> <td> Diamètre intérieur max. de la bobine d’induction avec disques de blindage »varOct« </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> </tr> <tr> <td> Diamètres thermorétractables avec bobine d’induction de 14 kVA </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> </tr> <tr> <td> Diamètres de rétraction avec bobine d’induction de 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 16–50 mm </td> </tr> <tr> <td> Valeurs de raccordement </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Valeurs de raccordement pneumatiques </td> <td class=\"text-center\"> 6–8 bar </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 6–8 bar </td> </tr> <tr> <td> Valeurs de raccordement électrique </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> </tr> <tr> <td> Câble d’alimentation </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> </tr> <tr> <td> Puissance connectée du système de rétraction par induction 14 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> </tr> <tr> <td> Puissance connectée du système de rétraction par induction 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 23 kVA </td> </tr> <tr> <td> Poids </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Sans système de refroidissement, refroidissement à air sous la bobine d’induction </td> <td class=\"text-center\"> ~ 35 kg </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Version établi, »zStream« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 150 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Version établi, cloches de refroidissement,<br/> poids en supplément du refroidisseur à eau </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 143 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ~ 153 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Avec support sous-table, »zStream« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 240 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Avec support sous-table, cloche de refroidissement </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 274 kg </td> <td class=\"text-center\"> ~ 284 kg </td> <td class=\"text-center\"> ~ 410 kg </td> </tr> </tbody> </table>",
