  {
   "type": "product_header",
   "title": "»mµFocus«",
   "text": "<p>L'analyse des structures les plus<br/>fines d'un outil</p> <p><a class=\"btn\" href=\"/fr/entreprise/contact\">Demander maintenant</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/8/csm_myFocus_header_de2cb108cf.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
