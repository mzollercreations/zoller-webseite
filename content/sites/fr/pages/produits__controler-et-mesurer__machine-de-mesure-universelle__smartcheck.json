  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Technique de contrôle et de mesure<br/>universelle pour un contrôle d'outil orienté fabrication</p> <p><a class=\"btn\" href=\"/fr/entreprise/contact\">Demander maintenant</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
