    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Deux modèles, de nombreuses options pratiques incluses : choisissez entre deux longueurs d'outil différentes et des accessoires pour une utilisation quotidienne optimale. Pour des processus de travail et des conditions de production entièrement personnalisés.<br/><br/>Faites votre choix de manière simple et avec un aperçu ou contactez-nous : nous vous conseillons volontiers dans la sélection de votre modèle et de la multitude d'options innovantes.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
