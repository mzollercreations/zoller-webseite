   }
  },
  {
   "type": "table",
   "header": "<h2> Poids d'installation </h2>",
   "table": "<table> <tbody> <tr> <td> »mμFocus« avec capteur »zep« et système sous table </td> <td> 250 »kg </td> </tr> <tr> <td> mμFocus« avec capteur »zep-R« et système sous table </td> <td> 270 »kg </td> </tr> <tr> <td> mμFocus« avec capteur »zep« sans système sous table </td> <td> 75 kg </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c4147",
   "bg": "lightgray",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Capteur »zep« pour mesurer la géométrie de la lame </h2>",
      "table": "<table> <tbody> <tr> <td> Axe Z </td> <td> 300 mm </td> </tr> <tr> <td> AA (décrit la distance minimale entre l'objectif et l'objet de mesure) </td> <td> Projection de rayons3 </td> </tr> <tr> <td> Principe de mesure </td> <td> 0 mm </td> </tr> <tr> <td> Rayon minimal mesurable </td> <td> 3 μm </td> </tr> <tr> <td> Ouverture numérique </td> <td> – </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4149",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Capteur »zep-R« pour la mesure de la géométrie de coupe 3D et de la rugosité de surface </h2>",
      "table": "<table> <tbody> <tr> <td> Axe Z </td> <td> 300 mm </td> </tr> <tr> <td> AA </td> <td> 20 mm </td> </tr> <tr> <td> Principe de mesure </td> <td> Microscope confocal </td> </tr> <tr> <td> Plus petit Rayon mesurable </td> <td> 3 μm (valeurs pour objectif 20x ; valeurs pour objectif 50x : 1,4 μm) </td> </tr> <tr> <td> Ouverture numérique </td> <td> 0,42 mm </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4151",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c4148",
   "bg": "",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Rugosité du profil : sélection de paramètres mesurables selon les normes ISO 4287 et ISO 13565 </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> moyenne arithmétique sur toute la longueur de mesure </td> </tr> <tr> <td> Rv </td> <td> profondeur de la plus grande vallée du profil de rugosité </td> </tr> <tr> <td> Rk </td> <td> profondeur de rugosité centrale, hauteur de la zone centrale </td> </tr> <tr> <td> Rpk </td> <td> hauteur de pointe réduite </td> </tr> <tr> <td> Rvk </td> <td> profondeur de rainure réduite </td> </tr> <tr> <td> Mr1 </td> <td> partie du matériau au-dessus de la zone centrale (courbe d'Abbott) </td> </tr> <tr> <td> Mr2 </td> <td> partie du matériau supportant la charge (courbe d'Abbott) </td> </tr> <tr> <td> Rsm </td> <td> largeur moyenne des rainures </td> </tr> <tr> <td> RPc </td> <td> valeur de comptage des pics </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Rugosité de surface : sélection de paramètres mesurables selon les normes ISO 25178-2 et ISO 16610 </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> hauteur arithmétique moyenne de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sq </td> <td> hauteur quadratique moyenne de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sp </td> <td> hauteur de pointe maximale de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sv </td> <td> hauteur maximale des creux de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sz </td> <td> hauteur maximale de l'interface limitée à l'échelle </td> </tr> <tr> <td> S10z </td> <td> Hauteur en dix points de l'interface </td> </tr> <tr> <td> Ssk </td> <td> Asymétrie de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sku </td> <td> Courtece de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sdq </td> <td> Gradient quadratique moyen de l'interface limitée à l'échelle </td> </tr> <tr> <td> Sdr </td> <td> Rapport de surface de transition développé d'une interface limitée à l'échelle </td> </tr> <tr> <td> FLT </td> <td> planéité </td> </tr> <tr> <td> Sk </td> <td> hauteur du noyau </td> </tr> <tr> <td> Spk </td> <td> hauteur de pointe réduite </td> </tr> <tr> <td> Svk </td> <td> hauteur de creux réduite </td> </tr> <tr> <td> Smr1 </td> <td> proportion de matière des pointes </td> </tr> <tr> <td> Smr2 </td> <td> proportion de matière des creux </td> </tr> <tr> <td> Vmc </td> <td> Volume de matériau du noyau d'une interface à échelle limitée </td> </tr> <tr> <td> Vmp </td> <td> Volume de matériau des pics d'une interface à échelle limitée </td> </tr> <tr> <td> Vvc </td> <td> Volume vide du noyau d'une interface à échelle limitée </td> </tr> <tr> <td> Vvv </td> <td> Volume vide des creux d'une interface à échelle limitée </td> </tr> <tr> <td> Sxp </td> <td> Valeur extrême de la hauteur de pointe </td> </tr> <tr> <td> Str </td> <td> Rapport d'aspect de la texture de l'interface </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4141",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
