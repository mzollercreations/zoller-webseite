      "items": [
       {
        "title": "»elephant 2.0« – extrêmement simple à utiliser",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>01. Sélection <strong>du type d'outil</strong>, par exemple fraise à queue &gt; fraise à queue avec rayon d'angle</p> <p>02. Sélection des <strong>paramètres</strong> souhaités</p> <p>03. <strong>Mesure</strong> active, par exemple Contour de travail du rayon d'angle</p> <p>04.<strong> Résultats de mesure </strong>(mesure entièrement automatique et sans saisie de données/programmation)</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/f/8/csm_software_elephant_06_a11abb5269.webp",
            "alt": "",
            "w": 1000,
            "h": 556
           }
          ],
          "videos": [],
          "pos": "below",
