    "before": "extra-small",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/8/5/csm_toolBalancer_Alexander_Zoller2_7bc76f629f.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Il est grand temps de moderniser la mise à disposition d'outils dans les processus de production. Le concept d'automatisation modulaire ZOLLER ouvre la voie à l'usine intelligente pour chaque fabrication. </p> <p><strong>Alexander Zoller, directeur général</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/2/7/csm_toolBalancer_Christoph_Zoller2_490ea1f2a5.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Les solutions d'automatisation ZOLLER constituent la prochaine étape logique pour vous. Augmentez l'efficacité de votre production grâce à des technologies innovantes.</p> <p><strong>Christoph Zoller, directeur général</strong></p>",
     "right": false,
     "quote": true,
     "dark": true
    }
   ],
