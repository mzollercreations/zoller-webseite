  {
   "type": "cols",
   "layout": "33-66",
   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> fonctionnalité </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c4101",
      "bg": "",
