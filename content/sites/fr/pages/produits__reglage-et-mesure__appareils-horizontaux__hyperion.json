  {
   "type": "product_header",
   "title": "»hyperion«",
   "text": "<p>Une productivité accrue grâce à des outils rotatifs configurés avec précision</p> <p><a class=\"btn\" href=\"/fr/entreprise/contact\">Demander maintenant</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/1/csm_hyperion_header_0b7c1cdce7.webp",
