    ],
    [
     {
      "type": "accordion",
      "header": "",
      "items": [
       {
        "title": "»elephant 2.0« - extremely easy to use",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>01. select <strong>tool type</strong> e.g. end mill &gt; end mill with corner radius</p> <p>02. selection of the desired <strong>parameters</strong></p> <p>03. active <strong>measurement</strong> e.g. cutting contour corner radius</p> <p>04.<strong> measurement results </strong>(19 pieces, measured fully automatically and without data input/programming)</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/e/8/csm_software_elephant_3788f74653.webp",
            "alt": "",
            "w": 1000,
            "h": 556
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c984",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "»expert« - intelligent, simple, ingenious",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>»expert« is the specialist for measurements on precision tools - based on the ZOLLER software »pilot 4.0«. The intelligent software generates the optimum measuring sequence from the selected parameters. Fully automatic, reproducible and with photorealistic parameter selection. The parameters to be measured can be selected easily, quickly and tool-specifically for the measuring program sequence using checkboxes. Simply select and confirm the parameters to be measured - and the measuring process starts.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/3/3/csm_software_expert_debaec8152.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c982",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       }
      ],
      "ftype": "accordion",
      "id": "c980",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
