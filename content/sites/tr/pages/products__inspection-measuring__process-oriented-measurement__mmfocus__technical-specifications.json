  },
  {
   "type": "table",
   "header": "<h2> Installation weights </h2>",
   "table": "<table> <tbody> <tr> <td> »mμFocus« with »zep« sensor and under-counter system </td> <td> 250 kg </td> </tr> <tr> <td> »mμFocus« with »zep-R« sensor and under-counter system </td> <td> 270 kg </td> </tr> <tr> <td> »mμFocus« with »zep« sensor without under-counter system </td> <td> 75 kg </td> </tr> </tbody> </table>",
   "ftype": "table",
   "id": "c4147",
   "bg": "lightgray",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> »zep« sensor for measuring the cutting edge geometry </h2>",
      "table": "<table> <tbody> <tr> <td> Z-axis </td> <td> 300 mm </td> </tr> <tr> <td> AA (describes the smallest distance between the lens and the object to be measured.) </td> <td> strip projection3 </td> </tr> <tr> <td> Measuring principle </td> <td> 0 mm </td> </tr> <tr> <td> Smallest measurable radius </td> <td> 3 μm </td> </tr> <tr> <td> Numerical aperture </td> <td> - </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4149",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> »zep-R« sensor for measuring the 3D cutting edge geometry and surface roughness </h2>",
      "table": "<table> <tbody> <tr> <td> Z-axis </td> <td> 300 mm </td> </tr> <tr> <td> AA </td> <td> 20 mm </td> </tr> <tr> <td> Measuring principle </td> <td> Confocal microscope </td> </tr> <tr> <td> smallest measurable radius </td> <td> 3 μm (values for 20x objective; values for 50x objective: 1.4 μm) </td> </tr> <tr> <td> Numerical aperture </td> <td> 0.42 mm </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4151",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c4148",
   "bg": "",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Profile roughness: Selection of measurable parameters according to ISO 4287 and ISO 13565 </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> arithmetic mean value over the entire measuring length </td> </tr> <tr> <td> Rq </td> <td> square mean value </td> </tr> <tr> <td> Rt </td> <td> total height of the roughness profile </td> </tr> <tr> <td> Rmax </td> <td> maximum height of the roughness profile within a single measuring section </td> </tr> <tr> <td> Rz </td> <td> average height of the roughness profile </td> </tr> <tr> <td> Rp </td> <td> height of the largest profile peak in the roughness profile </td> </tr> <tr> <td> Rv </td> <td> depth of the largest profile valley in the roughness profile </td> </tr> <tr> <td> Rk </td> <td> Core roughness depth, height of the core area </td> </tr> <tr> <td> Rpk </td> <td> reduced peak height </td> </tr> <tr> <td> Rvk </td> <td> reduced groove depth </td> </tr> <tr> <td> Mr1 </td> <td> Material portion above the core area (Abbott curve) </td> </tr> <tr> <td> Mr2 </td> <td> load-bearing material portion (Abbott curve) </td> </tr> <tr> <td> Rsm </td> <td> average groove width </td> </tr> <tr> <td> RPc </td> <td> peak count value </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Surface roughness: Selection of measurable parameters according to ISO 25178-2 and ISO 16610 </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> average arithmetic height of the scale-limited surface </td> </tr> <tr> <td> Sq </td> <td> average square height of the scale-limited surface </td> </tr> <tr> <td> Sp </td> <td> maximum peak height of the scale-limited surface </td> </tr> <tr> <td> Sv </td> <td> maximum sink height of the scale-limited surface </td> </tr> <tr> <td> Sz </td> <td> maximum height of the scale-limited surface </td> </tr> <tr> <td> S10z </td> <td> Ten-point height of the surface </td> </tr> <tr> <td> Ssk </td> <td> Slope of the scale-limited surface </td> </tr> <tr> <td> Sku </td> <td> kurtosis of the scale-limited surface </td> </tr> <tr> <td> Sdq </td> <td> mean square gradient of the scale-limited surface </td> </tr> <tr> <td> Sdr </td> <td> developed transition area ratio of a scale-limited surface </td> </tr> <tr> <td> FLT </td> <td> flatness </td> </tr> <tr> <td> Sk </td> <td> core height </td> </tr> <tr> <td> Spk </td> <td> reduced peak height </td> </tr> <tr> <td> Svk </td> <td> reduced valley height </td> </tr> <tr> <td> Smr1 </td> <td> material fraction peaks </td> </tr> <tr> <td> Smr2 </td> <td> material fraction valleys </td> </tr> <tr> <td> Vmc </td> <td> Core material volume of a scale-limited surface </td> </tr> <tr> <td> Vmp </td> <td> peak material volume of a scale-limited surface </td> </tr> <tr> <td> Vvc </td> <td> empty volume of the core of a scale-limited surface </td> </tr> <tr> <td> Vvv </td> <td> empty volume of the valleys of a scale-limited surface </td> </tr> <tr> <td> Sxp </td> <td> Extreme value of the peak height </td> </tr> <tr> <td> Str </td> <td> aspect ratio of the surface texture </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4141",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ]
