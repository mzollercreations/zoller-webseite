  {
   "type": "tiles",
   "header": "<h3> Courses tailor-made for your needs </h3>",
   "cols": 4,
   "tiles": [
    {
     "logo": {
      "src": "/fileadmin/_processed_/4/1/csm_training_01_15e3d65362.webp",
      "alt": "",
      "w": 680,
      "h": 490
     },
     "label": "Module 1 Commissioning and basic training for tool measuring machines",
     "img": null,
     "text": "<h4><strong>Basic training: tool measuring devices</strong></h4> <p>Installation and commissioning of the tool measuring machine</p> <p>Learning the basic functions</p> <p>Simple software training for measuring and presetting tools</p>"
    },
    {
     "logo": {
      "src": "/fileadmin/_processed_/c/5/csm_training_02_8b4cd3f636.webp",
      "alt": "",
      "w": 680,
      "h": 490
     },
     "label": "Module 2 Installation and basic training of your presetting and measurement program",
     "img": null,
     "text": "<h4><strong>Basic training: Your presetting and measuring program</strong></h4> <p>Professional installation of the desired program</p> <p>Learning basic program functions</p> <p>Individual consideration of user requirements</p>"
    },
    {
     "logo": {
      "src": "/fileadmin/_processed_/d/3/csm_training_03_210a4f667d.webp",
      "alt": "",
      "w": 680,
      "h": 490
     },
     "label": "Module 3 Training for TMS Tool Management Solutions software",
     "img": null,
     "text": "<h4><strong>Training: Software</strong></h4> <p>Learning the software functions</p> <p>Consideration of specific employee questions</p> <p>Duration depends on the selected software packages</p>"
    },
    {
     "logo": {
      "src": "/fileadmin/_processed_/9/7/csm_training_04_f621e06a9e.webp",
      "alt": "",
      "w": 680,
      "h": 490
     },
     "label": "Module 4 Individual training content customized to your requirements",
     "img": null,
     "text": "<h4><strong>Individual</strong><br/><strong>training content</strong></h4> <p>Network integration</p> <p>Re-training on the tool presetting and measuring machine</p> <p>Adaptation of output format</p> <p>Tool identification</p>"
    }
   ],
