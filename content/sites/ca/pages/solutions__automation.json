   "bg": "",
   "space": {}
  },
  {
   "type": "textmedia",
   "header": "<h2> A Competitive Edge Through Greater Cost-Effectiveness </h2>",
   "body": "<p><strong>Productivity is declining in many manufacturing operations because highly trained employees are forced to execute routine tasks. By automating tool assembly, retrieval, and transport with ZOLLER Automation Solutions, you can reduce this costly time expenditure.</strong></p> <p>Use the skilled workers’ available time optimally. Use your experts productively by applying their knowledge and experience where it is most needed. Your manufacturing operation’s productivity and profits will increase.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/d/7/csm_kosteneffizienz_einzel_b86afc398c.webp",
     "alt": "",
     "w": 1097,
     "h": 1097
    }
   ],
   "videos": [],
