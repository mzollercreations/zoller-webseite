  {
   "type": "product_header",
   "title": "»conDress 200«",
   "text": "<p>Czyszczenie i przywracanie zdolności skrawania narzędzi do obróbki kamienia</p> <p><a class=\"btn\" href=\"/pl/przedsiebiorstwa/kontakt\">Zapytaj teraz</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/1/9/csm_conDress_header_e81b30fcea.webp",
    "alt": "",
    "w": 1080,
    "h": 930
