    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Dwa modele, bogate wyposażenie standardowe i praktyczne opcje: wybierz jedną z dwóch długości narzędzi oraz akcesoria zapewniające optymalną codzienną eksploatację. Dostosowane do indywidualnych procesów roboczych i warunków panujących w Państwa zakładzie produkcyjnym.<br/><br/>Dokonajcie wyboru w prosty i przejrzysty sposób lub skontaktujcie się z nami: chętnie doradzimy Państwu w wyborze modelu oraz innowacyjnej gamie opcji.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
