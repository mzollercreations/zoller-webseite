  {
   "type": "product_header",
   "title": "Rozwiązania w zakresie oprzyrządowania",
   "text": "<p>Uchwyt narzędziowy jako idealne rozwiązanie<br/>dla cyfrowej produkcji</p> <p><a class=\"btn\" href=\"https://myzoller.com/de/de/shop/tooling\" rel=\"noopener\" target=\"_blank\">Kup teraz</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/d/c/csm_header_tooling_79126defc9.webp",
    "alt": "",
    "w": 1428,
    "h": 896
   },
   "ftype": "zoller_product_header",
   "id": "c1416",
   "bg": "",
