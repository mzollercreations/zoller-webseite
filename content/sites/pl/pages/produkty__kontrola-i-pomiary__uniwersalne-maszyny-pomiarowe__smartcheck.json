  {
   "type": "product_header",
   "title": "»smartCheck«",
   "text": "<p>Uniwersalny przyrząd kontrolno-pomiarowe<br/>do kontroli geometrii narzędzi</p> <p><a class=\"btn\" href=\"/pl/przedsiebiorstwa/kontakt\">Zapytaj teraz</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/d/csm_smartcheck_header_789d77464a.webp",
    "alt": "",
    "w": 1080,
    "h": 930
