   "slides": [
    {
     "img": "/fileadmin/_processed_/b/5/csm_header_zoller_profile_d86d616a1c.webp",
     "video": null,
     "title": "ZOLLER – innowacyjny, zakorzeniony w tradycji i otwarty na świat",
     "kicker": "",
     "text": "",
     "buttons": [],
     "light": false
    }
   ],
   "ftype": "zoller_hero-slider",
