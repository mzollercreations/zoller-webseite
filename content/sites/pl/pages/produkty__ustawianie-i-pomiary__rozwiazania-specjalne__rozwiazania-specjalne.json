 "blocks": [
  {
   "type": "textmedia",
   "header": "<h1> Specjalistyczne rozwiązania do ustawiania i pomiarów </h1>",
   "body": "",
   "images": [
    {
     "src": "/fileadmin/_processed_/f/6/csm_reamCheck_cd82613a3d.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»reamCheck«",
     "href": "/pl/produkty/ustawianie-i-pomiary/urzadzenia-pionowe/venturion/modele/reamcheck",
     "caption": "<figcaption> <h3>»reamCheck«</h3> <p>With »reamCheck«, you can set complete machining tools such as long reamers and fine boring tools fully automatically, quickly, accurately and independently of the operator.</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/e/5/csm_torquematic_a1d5f5dc22.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»torquematic«",
     "href": "/pl/produkty/ustawianie-i-pomiary/urzadzenia-pionowe/venturion/modele/torquematic",
     "caption": "<figcaption> <h3>»torquematic«</h3> <p>With »torquematic«, tools with collet tool holders can be set to length, clamped to a predefined torque and measured fully automatically.</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/8/0/csm_tribos_777b335f4d.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»tribos«",
     "href": "/pl/produkty/ustawianie-i-pomiary/urzadzenia-pionowe/venturion/modele/tribos",
     "caption": "<figcaption> <h3>»tribos«</h3> <p>With »tribos«, you can mount and measure the polygonal shrink fit tool holders of the TRIBOS type from SCHUNK with μm-precise length.</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/3/0/csm_redomatic_e7534663d3.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»redomatic«",
     "href": "/pl/produkty/technika-obkurczania/redomatic",
     "caption": "<figcaption> <h3>»redomatic«</h3> <p>»redomatic« is the high-end solution for automated measuring, adjusting and shrinking.</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/6/4/csm_smartCheck_704ca1e175.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»smartCheck«",
     "href": "/pl/produkty/kontrola-i-pomiary/uniwersalne-maszyny-pomiarowe/smartcheck",
     "caption": "<figcaption> <h3>»smartCheck«</h3> <p>The »smartCheck« setting, measuring and inspection device can visualize the surface condition of the cutting edge on the face and circumference.</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/c/1/csm_phoenix_4eb6d525d4.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»phoenix«",
     "href": "/pl/produkty/ustawianie-i-pomiary/rozwiazania-specjalne/rozwiazania-specjalne/phoenix",
     "caption": "<figcaption> <h3>»phoenix«</h3> <p>Maximum precision when measuring fine boring tools</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/4/3/csm_zenit_bbe8f40aa8.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»zenit«",
     "href": "/pl/produkty/ustawianie-i-pomiary/rozwiazania-specjalne/rozwiazania-specjalne/zenit",
     "caption": "<figcaption> <h3>»zenit«</h3> <p>Professional measurement of cutterheads</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/5/1/csm_eQuick_42324e4ab0.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»eQuick 200M«",
     "href": "/pl/produkty/ustawianie-i-pomiary/rozwiazania-specjalne/rozwiazania-specjalne/equick",
     "caption": "<figcaption> <h3>»eQuick 200M«</h3> <p>Ergonomic adjustment and measurement of crankshaft milling cutters in transmitted light</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/2/5/csm_gemini_1b17777a79.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»gemini«",
     "href": "/pl/produkty/ustawianie-i-pomiary/rozwiazania-specjalne/rozwiazania-specjalne/gemini",
     "caption": "<figcaption> <h3>»gemini«</h3> <p>Easy measurement of crankshaft milling cutters and turning/ broaching tools</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/9/4/csm_millCheck_75724a2dfc.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»millCheck«",
     "href": "/pl/produkty/ustawianie-i-pomiary/rozwiazania-specjalne/rozwiazania-specjalne/millcheck",
     "caption": "<figcaption> <h3>»millCheck«</h3> <p>Measuring face cutterheads and cap cutters with unrivaled speed</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/7/4/csm_smileGBO_1f744e422d.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»smile GBO«",
     "href": "/pl/produkty/ustawianie-i-pomiary/obrobka-kamienia-metoda-cnc/smile-gbo",
     "caption": "<figcaption> <h3>»smile GBO«</h3> <p>Specially designed for shaping tools in metal, wood and stone processing</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/5/7/csm_conDiaz_96e6184b6e.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»conDiaZ«",
     "href": "/pl/produkty/kontrola-i-pomiary/obrobka-kamienia-metoda-cnc/condiaz",
     "caption": "<figcaption> <h3>»conDiaZ«</h3> <p>Inspection device for testing and measuring<br/> stone working tools</p> <br/> Learn more </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/1/2/csm_conDress_6b84c07ba6.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "»conDress 200«",
     "href": "/pl/produkty/kontrola-i-pomiary/obrobka-kamienia-metoda-cnc/condress",
     "caption": "<figcaption> <h3>»conDress 200«</h3> <p>Dressing device for cleaning and restoring the cutting ability of stone processing tools</p> <br/> Learn more </figcaption>"
    }
   ],
