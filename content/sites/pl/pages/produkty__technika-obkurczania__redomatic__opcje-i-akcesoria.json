    [
     {
      "type": "textmedia",
      "header": "<h1> Najważniejsze cechy/sprzęt przyrządu »redomatic 600« </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1350",
      "bg": "",
