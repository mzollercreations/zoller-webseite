           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Zarządzanie programami NC – »zidCode 4.0«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Dzięki systemowi zarządzania programami NC firmy ZOLLER TMS Tool Management Solutions oraz funkcji przesyłania danych za pomocą »zidCode 4.0« maszyna ma do dyspozycji wszystko, czego potrzebuje do bezpiecznego działania.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/3/4/csm_software_nc-programmverwaltung_ef69649c40.webp",
            "alt": "",
            "w": 1000,
            "h": 542
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c954",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Technologia »idChip« – »zidCode 4.0«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Po zeskanowaniu kodu DataMatrix na wbudowanym chipie narzędzia maszyna CNC otrzymuje przez sieć wszystkie niezbędne dane dotyczące narzędzia.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/7/csm_software_idchip_9694061981.webp",
