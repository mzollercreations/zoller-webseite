  {
   "type": "hotspots",
   "header": "<h2> Ważne argumenty przemawiające za jakością produktów firmy ZOLLER </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/1/1/csm_venturion_infodots_cb4ce530c4.webp",
    "alt": "",
    "w": 1200,
