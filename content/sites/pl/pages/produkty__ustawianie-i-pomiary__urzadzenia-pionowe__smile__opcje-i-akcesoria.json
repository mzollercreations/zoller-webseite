   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> Opcje i <br/>akcesoria </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c2211",
