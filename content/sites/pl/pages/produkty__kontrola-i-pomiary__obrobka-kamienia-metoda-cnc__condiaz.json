  {
   "type": "product_header",
   "title": "»conDiaZ«",
   "text": "<p>Szybkie skanowanie konturów narzędzi do obróbki kamienia w ciągu kilku sekund.</p> <p><a class=\"btn\" href=\"/pl/przedsiebiorstwa/kontakt\">Zapytaj teraz</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/4/3/csm_conDiaz_header_e97f793397.webp",
    "alt": "",
    "w": 1080,
    "h": 930
   },
   "ftype": "zoller_product_header",
   "id": "c30009",
   "bg": "",
