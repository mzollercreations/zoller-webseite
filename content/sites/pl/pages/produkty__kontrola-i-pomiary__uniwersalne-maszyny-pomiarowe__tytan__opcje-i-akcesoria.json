           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Ręczna stacja do zapisu i odczytu RFID »mslz«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Do ręcznego zapisu/odczytu nośnika kodu na uchwycie narzędziowym za pomocą ręcznego czytnika.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/a/f/csm_option_rfid_34dfe1d75c.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c1542",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "zasilacz UPS",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Dzięki zasilaczowi awaryjnemu (UPS) w przypadku zakłóceń w sieci elektrycznej zapewnione jest prawidłowe wyłączenie komputera, co pozwala uniknąć utraty danych. Dostępne są napięcia sieciowe 230 V~ (Europa) lub 120 V~ (USA).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/2/csm_option_usv_4c4cb5d571.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
