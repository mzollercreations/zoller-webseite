     {
      "type": "textmedia",
      "header": "<h2> Tool management software that fits </h2>",
      "body": "<p>The modular TMS Tool Management Solutions software from ZOLLER offers all the functions and interfaces you would expect from modern tool management software.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c8119",
