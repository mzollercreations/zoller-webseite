    ],
    [
     {
      "type": "accordion",
      "header": "",
      "items": [
       {
        "title": "»elephant 2.0« - extremely easy to use",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>01. select <strong>tool type</strong> e.g. end mill &gt; end mill with corner radius</p> <p>02. selection of the desired <strong>parameters</strong></p> <p>03. active <strong>measurement</strong> e.g. cutting contour corner radius</p> <p>04.<strong> measurement results </strong>(measured fully automatically and without data input/programming)</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/f/8/csm_software_elephant_06_a11abb5269.webp",
            "alt": "",
            "w": 1000,
            "h": 556
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c2052",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "»hobCheck« - clever, fast, perfect",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>The »hobCheck« software makes the fast and μm-accurate measurement of gear cutting tools child's play - based on the ZOLLER »pilot 4.0« software. Cylindrical hobs are measured fully automatically and evaluated in accordance with DIN 3968.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/f/csm_hobCheck_software_en_dd23c529e9.webp",
            "alt": "",
            "w": 1920,
            "h": 1075
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c2050",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       }
      ],
      "ftype": "accordion",
      "id": "c2054",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
