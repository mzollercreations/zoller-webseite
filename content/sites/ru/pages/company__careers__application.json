   "html": "<form action=\"https://www.zoller.info/ru/company/careers/application?tx_form_formframework%5Baction%5D=perform&amp;tx_form_formframework%5Bcontroller%5D=FormFrontend&amp;cHash=3277dfb308f2a4907c9567d860ebc94e#bewerbungsformular-4080\" enctype=\"multipart/form-data\" id=\"bewerbungsformular-4080\" method=\"post\"> <div><input name=\"tx_form_formframework[bewerbungsformular-4080][__state]\" type=\"hidden\" value=\"TzozOToiVFlQTzNcQ01TXEZvcm1cRG9tYWluXFJ1bnRpbWVcRm9ybVN0YXRlIjoyOntzOjI1OiIAKgBsYXN0RGlzcGxheWVkUGFnZUluZGV4IjtpOjA7czoxMzoiACoAZm9ybVZhbHVlcyI7YTowOnt9fQ==e1fa0a6fff7432dcbaca0174b96641dc4234cdba\"/><input name=\"tx_form_formframework[__trustedProperties]\" type=\"hidden\" value='{\"bewerbungsformular-4080\":{\"text-1\":1,\"text-4\":1,\"D9rRJw\":1,\"text-2\":1,\"text-3\":1,\"email-1\":1,\"telephone-1\":1,\"text-5\":1,\"text-6\":1,\"fileupload-1\":{\"name\":1,\"type\":1,\"tmp_name\":1,\"error\":1,\"size\":1},\"fileupload-2\":{\"name\":1,\"type\":1,\"tmp_name\":1,\"error\":1,\"size\":1},\"fileupload-3\":{\"name\":1,\"type\":1,\"tmp_name\":1,\"error\":1,\"size\":1},\"textarea-1\":1,\"checkbox-1\":1,\"__currentPage\":1}}07a181f3863d77c21de30ca89e70328c75bf3240'/> </div> <fieldset class=\"form-group\" id=\"bewerbungsformular-4080-fieldset-4\"> <div class=\"row\"> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-text-1\">Unsolicited application for a position as <span class=\"required\">*</span> </label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-text-1\" name=\"tx_form_formframework[bewerbungsformular-4080][text-1]\" required=\"required\" type=\"text\" value=\"\"/> </div> </div> </div> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-text-4\">Department <span class=\"required\">*</span> </label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-text-4\" name=\"tx_form_formframework[bewerbungsformular-4080][text-4]\" required=\"required\" type=\"text\" value=\"\"/> </div> </div> </div> </div> </fieldset> <input aria-hidden=\"true\" data-id=\"D9rRJw\" id=\"bewerbungsformular-4080-D9rRJw\" name=\"tx_form_formframework[bewerbungsformular-4080][D9rRJw]\" tabindex=\"-1\" type=\"text\"/> <fieldset class=\"form-group\" id=\"bewerbungsformular-4080-fieldset-3\"> <div class=\"row\"> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-text-2\">First name <span class=\"required\">*</span> </label> <div class=\"input\"> <input autocomplete=\"given-name\" class=\"form-control\" id=\"bewerbungsformular-4080-text-2\" maxlength=\"100\" minlength=\"1\" name=\"tx_form_formframework[bewerbungsformular-4080][text-2]\" required=\"required\" type=\"text\" value=\"\"/> </div> </div> </div> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-text-3\">Last name <span class=\"required\">*</span> </label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-text-3\" name=\"tx_form_formframework[bewerbungsformular-4080][text-3]\" required=\"required\" type=\"text\" value=\"\"/> </div> </div> </div> </div> <div class=\"row\"> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-email-1\">Email address <span class=\"required\">*</span> </label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-email-1\" name=\"tx_form_formframework[bewerbungsformular-4080][email-1]\" required=\"required\" type=\"email\" value=\"\"/> </div> </div> </div> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-telephone-1\">Telephone number <span class=\"required\">*</span> </label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-telephone-1\" name=\"tx_form_formframework[bewerbungsformular-4080][telephone-1]\" required=\"required\" type=\"tel\" value=\"\"/> </div> </div> </div> </div> <div class=\"row\"> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-text-5\">Street/house number</label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-text-5\" name=\"tx_form_formframework[bewerbungsformular-4080][text-5]\" type=\"text\" value=\"\"/> </div> </div> </div> <div class=\"col-6 col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6\"> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-text-6\">Postal code/City</label> <div class=\"input\"> <input class=\"form-control\" id=\"bewerbungsformular-4080-text-6\" name=\"tx_form_formframework[bewerbungsformular-4080][text-6]\" type=\"text\" value=\"\"/> </div> </div> </div> </div> </fieldset> <fieldset class=\"form-group\" id=\"bewerbungsformular-4080-fieldset-1\"> <div class=\"clearfix\"> <p><br/> Your documents: please attach them in PDF format with a total size of no more than 10 MB.<br/> <br/> <br/> </p> </div> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-fileupload-1\">Cover letter (PDF) <span class=\"required\">*</span> </label> <div class=\"input\"> <input accept=\"application/pdf\" id=\"bewerbungsformular-4080-fileupload-1\" name=\"tx_form_formframework[bewerbungsformular-4080][fileupload-1]\" required=\"required\" type=\"file\"/> </div> </div> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-fileupload-2\">Résumé (PDF) <span class=\"required\">*</span> </label> <div class=\"input\"> <input accept=\"application/pdf\" id=\"bewerbungsformular-4080-fileupload-2\" name=\"tx_form_formframework[bewerbungsformular-4080][fileupload-2]\" required=\"required\" type=\"file\"/> </div> </div> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-fileupload-3\">References and certificates (PDF) <span class=\"required\">*</span> </label> <div class=\"input\"> <input accept=\"application/pdf\" id=\"bewerbungsformular-4080-fileupload-3\" name=\"tx_form_formframework[bewerbungsformular-4080][fileupload-3]\" required=\"required\" type=\"file\"/> </div> </div> <div class=\"form-group\"> <label class=\"form-label\" for=\"bewerbungsformular-4080-textarea-1\">Your message</label> <div class=\"input\"> <textarea class=\"xxlarge form-control\" id=\"bewerbungsformular-4080-textarea-1\" name=\"tx_form_formframework[bewerbungsformular-4080][textarea-1]\"></textarea> </div> </div> </fieldset> <fieldset class=\"form-group\" id=\"bewerbungsformular-4080-fieldset-2\"> <div class=\"clearfix\"> <p><br/> Please note: ZOLLER stores the data you submit in order to select a suitable applicant. Your personal data is stored and processed in accordance with the General Data Protection Regulation (GDPR). Your information is treated in strict confidence and is not passed on to third parties. If we cannot find a suitable position for your profile, we will delete the data you submitted after two months at the latest.<br/> <br/> </p> </div> <div class=\"form-group\"> <div class=\"input checkbox\"> <div class=\"form-check\"> <label class=\"add-on form-check-label\" for=\"bewerbungsformular-4080-checkbox-1\"> <input name=\"tx_form_formframework[bewerbungsformular-4080][checkbox-1]\" type=\"hidden\" value=\"\"/><input class=\"add-on\" id=\"bewerbungsformular-4080-checkbox-1\" name=\"tx_form_formframework[bewerbungsformular-4080][checkbox-1]\" required=\"required\" type=\"checkbox\" value=\"1\"/> <span>You agree that the data entered above may be used to process your request for sales activities and passed on to the responsible sales subsidiaries or sales representatives. You may object to this data processing at any time, without giving reasons, by writing to datenschutz@zoller.info. <span class=\"required\">*</span> </span> </label> </div> </div> </div> </fieldset> <div class=\"actions\"> <nav class=\"form-navigation\"> <div class=\"btn-toolbar\" role=\"toolbar\"> <div class=\"btn-group\" role=\"group\"> <span class=\"btn-group next submit\"> <button class=\"block-button\" name=\"tx_form_formframework[bewerbungsformular-4080][__currentPage]\" type=\"submit\" value=\"1\"> Send email </button> </span> </div> </div> </nav> </div> </form>",
