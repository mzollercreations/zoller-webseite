    "after": "default"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2> The indispensable all-rounder for turning operations </h2>",
   "body": "<p><strong>Whether you want to set and measure tools for lathes, machining centers or milling centers - with ZOLLER »hyperion«, a single measuring device is all you need for almost all your different tool holders. The various tool holders are permanently mounted on a turret table, making them particularly quick and easy to use.</strong></p> <p>Whether you choose manual or CNC-controlled, with this device you are opting for maximum universality and will immediately benefit from a significant increase in productivity thanks to 100% prepared and tested tools.</p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/2/d/csm_hyperion_intro_deb7604992.webp",
     "alt": "",
     "w": 1454,
     "h": 1454
    }
   ],
   "videos": [],
   "pos": "right",
   "cols": 1,
   "valign": "center",
   "ftype": "textmedia",
   "id": "c3360",
   "bg": "",
