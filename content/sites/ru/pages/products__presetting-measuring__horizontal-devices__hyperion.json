   "type": "product_header",
   "title": "»hyperion«",
   "text": "<p>Higher productivity thanks to precisely adjusted turning tools</p> <p><a class=\"btn\" href=\"/ru/company/contact\">Inquire now</a></p>",
   "img": {
    "src": "/fileadmin/_processed_/c/1/csm_hyperion_header_0b7c1cdce7.webp",
    "alt": "",
