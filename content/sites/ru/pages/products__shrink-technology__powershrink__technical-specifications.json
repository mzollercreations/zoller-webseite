  {
   "type": "table",
   "header": "",
   "table": "<table> <tbody> <tr> <td> </td> <td class=\"text-center\"> »powerShrink 200« </td> <td class=\"text-center\"> »powerShrink 300« </td> <td class=\"text-center\"> »powerShrink 400« </td> <td class=\"text-center\"> »powerShrink 600« </td> </tr> <tr> <td> Shrinkable tool length </td> <td class=\"text-center\"> 400 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> <td class=\"text-center\"> 600 mm </td> </tr> <tr> <td> Maximum inner diameter of induction coil »varOct« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 45.8 mm </td> <td class=\"text-center\"> 45.8 mm </td> <td class=\"text-center\"> 45.8 mm </td> </tr> <tr> <td> Maximum inner diameter of the induction coil with shielding discs </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> <td class=\"text-center\"> 50 mm </td> </tr> <tr> <td> Shrink-clampable diameter with 14 kVA induction coil </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> <td class=\"text-center\"> 3–32 mm </td> </tr> <tr> <td> Shrink-clampable diameter with 22 kVA induction coil </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 16–50 mm </td> </tr> <tr> <td> Requirements </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> Pneumatic requirement </td> <td class=\"text-center\"> 6–8 bar </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 6–8 bar </td> </tr> <tr> <td> Electrical load </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> <td class=\"text-center\"> 400 V 3~ /N/PE, 50 Hz </td> </tr> <tr> <td> Main cable supply </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> <td class=\"text-center\"> 3 m </td> </tr> <tr> <td> Connected load induction heat shrink system 14 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> <td class=\"text-center\"> 15 kVA </td> </tr> <tr> <td> Connected load induction heat shrink system 22 kVA </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> 23 kVA </td> </tr> <tr> <td> Weights </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> <td class=\"text-center\"> </td> </tr> <tr> <td> No cooling system, air cooling beneath the induction coil </td> <td class=\"text-center\"> ~ 35 kg </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Workbench version, »zStream« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 150 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> Workbench version, cooling bells,<br/> Additional weight of water cooler </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 143 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ~ 153 kg<br/> ~ 42 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> With table, »zStream« </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 240 kg </td> <td class=\"text-center\"> ― </td> </tr> <tr> <td> With table, cooling bells </td> <td class=\"text-center\"> ― </td> <td class=\"text-center\"> ~ 274 kg </td> <td class=\"text-center\"> ~ 284 kg </td> <td class=\"text-center\"> ~ 410 kg </td> </tr> </tbody> </table>",
