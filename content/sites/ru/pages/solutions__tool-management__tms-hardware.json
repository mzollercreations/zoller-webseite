     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Do you want to work more productively and economically with an efficient tool store? Then ZOLLER Smart Cabinets are just right for you!</p> <p class=\"large-text\">We offer the right storage solution, regardless of whether you want to manage tools and their components, accessories or measuring and inspection equipment. Thanks to the software connection, the entire warehouse can be displayed virtually.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
