    [
     {
      "type": "textmedia",
      "header": "<h2> Accessories </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1268",
