  {
   "type": "hotspots",
   "header": "<h2> A kompakt kialakítás a részletekben </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/5/a/csm_pomBasic_update_infodots_149a443d10.webp",
    "alt": "",
    "w": 1213,
