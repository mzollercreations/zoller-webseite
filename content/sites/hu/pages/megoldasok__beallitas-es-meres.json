    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>Aki a CNC-gép fő működési idejével párhuzamosan végzi el a szerszámok méretellenőrzését, hatékonyabban gyárt. </h3>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c614",
      "bg": "",
