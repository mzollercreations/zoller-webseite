  {
   "type": "hotspots",
   "header": "<h2> A rendszermegoldás részletesen </h2>",
   "intro": "",
   "img": {
    "src": "/fileadmin/_processed_/c/4/csm_micBox_info_3a0fe484f7.webp",
    "alt": "",
    "w": 1476,
    "h": 866
   },
   "spots": [
    {
     "x": 10.983,
     "y": 44.136,
     "label": "Többszörös fogó-tár",
     "text": "<h3>Többszörös fogó-tár</h3> <h4>Fogó-tár – </h4> <p>amely akár hat fogót is tárolhat különböző forgóbetétekhez.</p>"
    },
    {
     "x": 24.277,
     "y": 26.858,
     "label": "Agilis 6-tengelyes robot",
     "text": "<h3>Agilis 6-tengelyes robot</h3> <h4>6 tengelyes robot – </h4> <p>a Fanuc gyártmányú, amellyel a forgóvágólemezeket és a csavarokat precízen cserélik.</p>"
    },
    {
     "x": 47.451,
     "y": 11.907,
     "label": "Beépített tartó a cserélhető vágólemezekhez",
     "text": "<h3>Beépített tartó a cserélhető vágólemezekhez</h3> <h4>Tárcsa cserélhető pengékhez – </h4> <p>elegendő helyet biztosít. A »micBox-on« belüli két tár külön-külön is feltölthető.</p>"
    },
    {
     "x": 61.009,
     "y": 37.869,
     "label": "Beépített kenőegység",
     "text": "<h3>Beépített kenőegység</h3> <h4>Kenőegység – </h4> <p>csavarokhoz speciális zsírt tartalmaz, és garantálja a csavarok egyszerű meglazítását a csavarozóegység segítségével.</p>"
    },
    {
     "x": 54.598,
     "y": 50.045,
     "label": "Mozgatható forgó- és billenőegység",
     "text": "<h3>Mozgatható forgó- és billenőegység</h3> <h4>Forgó- és fordítóegység – </h4> <p>amelyet a 6 tengelyes robot szerel fel cserélhető vágólemezekkel. A cserélhető vágólemezek 6 tengelyes robot segítségével történő behelyezése a forgó- és fordítóegységbe biztosítja a vágólemezek újbóli beállítását. A csavarmagazin segítségével szükség esetén mindig új csavart használnak a szerszámhoz.</p>"
    },
    {
     "x": 54.808,
     "y": 64.548,
     "label": "Hatékony csavarozó egység",
     "text": "<h3>Hatékony csavarozó egység</h3> <h4>Csavarozó egység – </h4> <p>beépített vákuumfogóval, amely a robotra van szerelve, és mindig biztosítja a csavarok pontos cseréjét és meghúzását a megfelelő nyomatékkal.</p>"
    },
    {
     "x": 38.886,
     "y": 66.338,
     "label": "Rendkívül pontos univerzális orsó",
     "text": "<h3>Rendkívül pontos univerzális orsó</h3> <h4>Univerzális orsó – </h4> <p>lehetővé teszi akár 20 kg-os szerszámok befogadását, valamint biztosítja a szerszámok pontos pozicionálását forgás közben.</p>"
    },
    {
     "x": 18.129,
     "y": 76.992,
     "label": "Nagy teljesítményű vezérlőszoftver",
     "text": "<h3>Nagy teljesítményű vezérlőszoftver</h3> <h4>Vezérlőszoftver – </h4> <p>biztosítja a »micBox« teljes körű kezelését. A szoftver külső képernyőkön is megjeleníthető.</p>"
    }
   ],
