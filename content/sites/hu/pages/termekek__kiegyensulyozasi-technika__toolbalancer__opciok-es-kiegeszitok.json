    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"extra-large-text\">Két modell, számos alapfelszereltség és praktikus kiegészítő: válasszon a két különböző szerszámhosszúság és a kiegészítők közül az optimális mindennapi használat érdekében. Az Ön gyártási folyamatainak és körülményeinek teljes mértékben megfelelően.<br/><br/>Válasszon egyszerűen és áttekinthetően, vagy vegye fel velünk a kapcsolatot: szívesen segítünk a modell kiválasztásában és az innovatív kiegészítők széles választékában.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
