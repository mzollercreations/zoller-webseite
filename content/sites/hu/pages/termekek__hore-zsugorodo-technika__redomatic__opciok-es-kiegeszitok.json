   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h1> A »redomatic 600« legfontosabb jellemzői/hardvere </h1>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1350",
