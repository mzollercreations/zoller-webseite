    [
     {
      "type": "table",
      "header": "<h2> »zep« érzékelő a vágóélek geometriájának méréséhez </h2>",
      "table": "<table> <tbody> <tr> <td> Z-tengely </td> <td> 300 mm </td> </tr> <tr> <td> AA (az objektív és a mérendő tárgy közötti legkisebb távolságot jelöli) </td> <td> Csíkvetítés 3 </td> </tr> <tr> <td> Mérési elv </td> <td> 0 mm </td> </tr> <tr> <td> A legkisebb mérhető sugár </td> <td> 3 μm </td> </tr> <tr> <td> Numerikus apertúra </td> <td> – </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4149",
