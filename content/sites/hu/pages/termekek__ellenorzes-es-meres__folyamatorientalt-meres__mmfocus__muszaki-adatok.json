  {
   "type": "cols",
   "layout": "50-50",
   "columns": [
    [
     {
      "type": "table",
      "header": "<h2> Profil-érdesség: mérhető paraméterek kiválasztása az ISO 4287 és az ISO 13565 szabványok szerint </h2>",
      "table": "<table> <tbody> <tr> <td> Ra </td> <td> aritmetikai átlag a teljes mérési hosszúságon </td> </tr> <tr> <td> Rq </td> <td> négyzetes átlag </td> </tr> <tr> <td> Rt </td> <td> a felületi érdességi profil teljes magassága </td> </tr> <tr> <td> Rmax </td> <td> a felületi érdességi profil legnagyobb magassága egy adott mérési szakaszon belül </td> </tr> <tr> <td> Rz </td> <td> a felületi érdességi profil átlagos magassága </td> </tr> <tr> <td> Rp </td> <td> a felületi érdességi profil legnagyobb csúcsmagassága </td> </tr> <tr> <td> Rv </td> <td> a legnagyobb profilvölgy mélysége a felületi érdességi profilban\\ </td> </tr> <tr> <td> Rk </td> <td> magérdesség, a magterület magassága\\ </td> </tr> <tr> <td> Rpk </td> <td> csökkentett csúcsmagasság\\ </td> </tr> <tr> <td> Rvk </td> <td> csökkentett barázda mélység\\ </td> </tr> <tr> <td> Mr1 </td> <td> a magterület feletti anyagrészesedés (Abbott-görbe)\\ </td> </tr> <tr> <td> Mr2 </td> <td> terhelést viselő anyagrészesedés (Abbott-görbe)\\ </td> </tr> <tr> <td> Rsm </td> <td> átlagos barázda szélesség </td> </tr> <tr> <td> RPc </td> <td> csúcsok számának értéke </td> </tr> </tbody> </table>",
      "ftype": "table",
      "id": "c4142",
      "bg": "",
      "space": {
       "before": "extra-small",
       "after": "extra-small"
      }
     }
    ],
    [
     {
      "type": "table",
      "header": "<h2> Felületi érdesség: mérhető paraméterek kiválasztása az ISO 25178-2 és az ISO 16610 szabványok szerint </h2>",
      "table": "<table> <tbody> <tr> <td> Sa </td> <td> a skálázott felület átlagos aritmetikai magassága </td> </tr> <tr> <td> Sq </td> <td> a skálázott felület átlagos négyzetes magassága </td> </tr> <tr> <td> Sp </td> <td> a skálázott felület legnagyobb csúcsmagassága </td> </tr> <tr> <td> Sv </td> <td> a skálázott felület legnagyobb mélypontja </td> </tr> <tr> <td> Sz </td> <td> a skálázott felület legnagyobb magassága </td> </tr> <tr> <td> S10z </td> <td> A felület tízpontos magassága </td> </tr> <tr> <td> Ssk </td> <td> A skálázott felület ferde szöge </td> </tr> <tr> <td> Sku </td> <td> A skálázott felület kurtózisa </td> </tr> <tr> <td> Sdq </td> <td> A skálázott felület átlagos négyzetes gradiense </td> </tr> <tr> <td> Sdr </td> <td> A skálázott felület kiterjesztett átmeneti felületi aránya </td> </tr> <tr> <td> FLT </td> <td> Sima felület </td> </tr> <tr> <td> Sk </td> <td> Magmagasság </td> </tr> <tr> <td> Spk </td> <td> Redukált csúcsmagasság </td> </tr> <tr> <td> Svk </td> <td> Redukált völgymagasság </td> </tr> <tr> <td> Smr1 </td> <td> Csúcsok anyagaránya </td> </tr> <tr> <td> Smr2 </td> <td> Völgyek anyagaránya </td> </tr> <tr> <td> Vmc </td> <td> skálakorlátozott felület maganyag-térfogata </td> </tr> <tr> <td> Vmp </td> <td> skálakorlátozott felület csúcsanyag-térfogata </td> </tr> <tr> <td> Vvc </td> <td> skálakorlátozott felület magjának üres térfogata </td> </tr> <tr> <td> Vvv </td> <td> skálakorlátozott felület völgyeinek üres térfogata </td> </tr> <tr> <td> Sxp </td> <td> csúcsmagasság szélsőértéke </td> </tr> <tr> <td> Str </td> <td> felületi textúra oldalaránya </td> </tr> </tbody> </table>",
