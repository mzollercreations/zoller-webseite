   "ftype": "textmedia",
   "id": "c700",
   "bg": "white",
   "space": {
    "before": "small",
    "after": "small"
   }
  },
  {
   "type": "textmedia",
   "header": "<h2 class=\"headline-decor\"> Fontos szerszámadatok </h2>",
   "body": "<p class=\"large-text\">Az adatok kulcsfontosságú szerepet játszanak a ZOLLER rendszerben. A zsugorítási folyamatok során is keletkeznek olyan szerszámadatok, amelyek felhasználhatók a szerszámkezeléshez. Minden olyan szerszám esetében, amely ZOLLER »idChip«-pel van ellátva, automatikusan rögzítheti a fűtési ciklusokat, és elmentheti azokat a »pilot 4.0« szoftverbe. </p>",
   "images": [
    {
     "src": "/fileadmin/_processed_/9/0/csm_shrinking_02_d3c241dbbc.webp",
     "alt": "",
     "w": 1920,
     "h": 1967
