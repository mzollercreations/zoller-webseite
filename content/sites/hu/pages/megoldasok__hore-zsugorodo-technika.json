    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>Újragondoltuk a zsugorítási technológiát. A zsugorítás és a kinyújtás most hatékonyabb, mint valaha. </h3>",
      "images": [],
      "videos": [],
      "pos": "text",
