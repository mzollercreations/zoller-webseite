     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>A ZOLLER Automation Solutions számos dolgot másképp és sokkal jobban csinál. A szerszámgyártási folyamatok hatékonyságát a csúcsra emeli.</h3>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
