          "id": "c1544",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "Kézi RFID írási/olvasási állomás »mslz«",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>A kódhordozó kézi írásához/olvasásához a szerszámfoglalatnál kézi leolvasó segítségével.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/a/f/csm_option_rfid_34dfe1d75c.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c1542",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "UPS-rendszer",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>A szünetmentes tápellátást biztosító UPS-berendezés gondoskodik arról, hogy áramkimaradás esetén a számítógép megfelelően leálljon, így elkerülhető legyen az adatvesztés. A berendezés 230 V~ (Európa) vagy 120 V~ (USA) hálózati feszültségre használható.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/2/csm_option_usv_4c4cb5d571.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
