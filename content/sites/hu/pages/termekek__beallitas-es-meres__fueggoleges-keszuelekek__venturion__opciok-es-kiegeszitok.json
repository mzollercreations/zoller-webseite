           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "CNC-es forgószerkezet",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Mérőeszközök torzításmentes méréséhez, például menetvágó szerszámok és hengeres marók esetében.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/8/csm_option_cnc_schwenkeinrichtung_0fc04921b8.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3321",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "»Asza« automatikus hosszúságütköző rendszer",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>CNC-vezérlésű lineáris beállítószerkezet a szerszámok hosszának ütközőrudon keresztül történő beállításához. Alternatívaként »asza-rot« kivitelben is kapható, amelynél a szerszám hossza a hosszbeállító csavar automatikus elforgatásával is beállítható (nem vonatkozik a zsugorcsatlakozós befogókra).</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/d/1/csm_option_asza_32f127ae86.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3319",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "A torony Y-tengelye",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>A kiegészítő Y-tengelynek köszönhetően az optikai tartót CNC-vezérléssel akár ±50 mm-re is el lehet helyezni az orsó közepétől Y-irányban. A forgásközéppont-mérő kamerával kombinálva ez lehetővé teszi a forgószerszámok és a multifunkciós szerszámok hatékony és rendkívül pontos mérését, valamint a hegymagasságra történő beállítását.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/3/6/csm_option_yachse_7a1e458de7.webp",
            "alt": "",
            "w": 1000,
            "h": 563
           }
          ],
          "videos": [],
          "pos": "below",
          "cols": 1,
          "valign": "top",
          "ftype": "textpic",
          "id": "c3317",
          "bg": "",
          "space": {
           "before": "default",
           "after": "default"
          }
         }
        ]
       },
       {
        "title": "»Phoenix« hátsó orsó kivitel",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>A hátsó orsó kényelmesen leengedhető, és a hosszú, vékony szerszámokat meghatározott nyomóerővel pontosan a helyükön tartja. A szerszámok mellett alkatrészeket is lehet a csúcsok között megmérni.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/b/5/csm_option_reitstock_phoenix_249d45464d.webp",
