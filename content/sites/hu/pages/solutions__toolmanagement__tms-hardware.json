    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Hatékony szerszámraktárral szeretne termelékenyebben és gazdaságosabban dolgozni? Akkor a ZOLLER Smart Cabinets pontosan az Ön számára készült!</p> <p class=\"large-text\">Kínálunk megfelelő raktározási megoldást, függetlenül attól, hogy szerszámokat és azok alkatrészeit, tartozékokat vagy mérő- és ellenőrző eszközöket szeretne kezelni. A szoftveres kapcsolódásnak köszönhetően a teljes raktár virtuálisan megjeleníthető.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c163314",
   "bg": "",
