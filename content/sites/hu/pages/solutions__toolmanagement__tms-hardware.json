    "before": "none",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/1/e/csm_josua_schade_9179cf0129.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Mi, a ZOLLER-nél a hardvert és a szoftvert a felhasználók igényeihez igazítjuk. Így gyakorlatias megoldásokat kínálunk egy kézből.</p> <p><strong>Josua Schade, TMS-hardver termékmenedzsment</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/b/csm_sarah-michelle_wiacek_c4c06a6999.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">A németországi Pleidelsheimben működő ZOLLER szerelőcsapat minden nap mindent megtesz azért, hogy a Smart Cabinets termékeink minősége mindig kiváló legyen. Egyszerűen fantasztikus részese lenni ennek!</p> <p><strong>Sarah-Michelle Wiacek, munkatervező csapat</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/0/9/csm_michael_haas_a5847acaff.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">A Smart Cabinets segítségével a ZOLLER ügyfelei nemcsak a hatékonyságot növelik, hanem elkerülik a gyártási folyamat során előforduló hibákat is.</p> <p><strong>Michael Haas, ZOLLER Dél értékesítési vezető</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    }
   ],
