   "layout": "33-66",
   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Kiegészítők </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c1268",
      "bg": "",
