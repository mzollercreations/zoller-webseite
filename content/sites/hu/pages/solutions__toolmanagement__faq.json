     {
      "type": "textmedia",
      "header": "<h1> GYIK </h1>",
      "body": "<p>Gyakran feltett kérdések</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c162758",
