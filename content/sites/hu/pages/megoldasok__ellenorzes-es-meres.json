     {
      "type": "textmedia",
      "header": "",
      "body": "<h3>A minőség bizonyítéka a részletekben rejlik. A ZOLLER segítségével mindent ellenőrizhet, ami a minőség szempontjából döntő fontosságú. </h3>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c686",
      "bg": "",
